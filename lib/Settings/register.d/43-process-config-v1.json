{
  "components": {
    "schemas": {
      "ProcessTemplate": {
        "slug": "process-template",
        "icon": "Sitemap",
        "version": "0.1.0",
        "title": "ProcessTemplate",
        "description": "A reusable governance process template: the state machine, default voting rule, and quorum policy a governance body follows for its decisions and meetings.",
        "type": "object",
        "x-openregister": {
          "schemaType": "custom:ProcessTemplate",
          "active": true,
          "hardDelete": false,
          "searchable": true,
          "mailEnabled": false
        },
        "required": [
          "name",
          "initialState",
          "stateMachine"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable template name.",
            "example": "Association ALV"
          },
          "description": {
            "type": "string",
            "description": "Optional description of when this template applies."
          },
          "context": {
            "type": "string",
            "description": "Governance context this template is intended for (maps to the guard fallback domain when unset).",
            "enum": [
              "association",
              "corporate",
              "legislative",
              "operations",
              "citizen"
            ],
            "example": "association"
          },
          "builtIn": {
            "type": "boolean",
            "description": "Read-only built-in template shipped with the app. Edit/delete are refused; duplicate is allowed (clears this flag).",
            "default": false,
            "example": true
          },
          "initialState": {
            "type": "string",
            "description": "The state a decision enters this template at.",
            "example": "draft"
          },
          "stateMachine": {
            "type": "object",
            "description": "Structured state machine (1:1 convertible to Symfony Workflow YAML). states[] declares the lifecycle states; transitions[] declares the edges.",
            "properties": {
              "states": {
                "type": "array",
                "description": "Lifecycle states.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              },
              "transitions": {
                "type": "array",
                "description": "Allowed transitions between states.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "from": { "type": "string" },
                    "to": { "type": "string" },
                    "chairOnly": { "type": "boolean", "default": false },
                    "guards": {
                      "type": "array",
                      "description": "Guard tokens enforced before this transition (quorum_met, chair_only, all_amendments_resolved, legal_review_complete).",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "votingRule": {
            "type": "object",
            "description": "Default voting rule applied to rounds opened under a body assigned this template.",
            "properties": {
              "voteThreshold": {
                "type": "string",
                "enum": [
                  "simple-majority",
                  "qualified-majority-two-thirds",
                  "qualified-majority-three-quarters",
                  "unanimous"
                ],
                "example": "simple-majority"
              },
              "abstentionHandling": {
                "type": "string",
                "enum": ["exclude", "count"],
                "example": "exclude"
              },
              "tieBreakRule": {
                "type": "string",
                "enum": ["rejected", "chair-decides", "revote"],
                "example": "rejected"
              }
            }
          },
          "quorumRequired": {
            "type": "boolean",
            "description": "Whether quorum must be met before a decision may enter the voting state under this template.",
            "default": true,
            "example": true
          },
          "quorumRule": {
            "type": "string",
            "description": "Free-text human description of the quorum requirement (e.g. '50%+1 of members present or represented').",
            "example": "50%+1 of members present or represented"
          },
          "allowDecideWithoutVote": {
            "type": "boolean",
            "description": "Permits the deliberating -> decided edge (operational domains where a formal voting round is optional).",
            "default": false,
            "example": false
          }
        },
        "x-openregister-seeds": [
          {
            "@self": {
              "register": "decidesk",
              "schema": "ProcessTemplate",
              "slug": "association-alv"
            },
            "name": "Association ALV",
            "description": "Standard decision process for a Dutch association general meeting (ALV), BW Book 2.",
            "context": "association",
            "builtIn": true,
            "initialState": "draft",
            "stateMachine": {
              "states": [
                { "name": "draft" },
                { "name": "proposed" },
                { "name": "deliberating" },
                { "name": "voting" },
                { "name": "decided" },
                { "name": "enacted" },
                { "name": "archived" }
              ],
              "transitions": [
                { "name": "propose", "from": "draft", "to": "proposed" },
                { "name": "deliberate", "from": "proposed", "to": "deliberating" },
                { "name": "openVoting", "from": "deliberating", "to": "voting", "chairOnly": true, "guards": ["quorum_met"] },
                { "name": "decide", "from": "voting", "to": "decided" },
                { "name": "enact", "from": "decided", "to": "enacted" },
                { "name": "archive", "from": "enacted", "to": "archived" }
              ]
            },
            "votingRule": {
              "voteThreshold": "simple-majority",
              "abstentionHandling": "exclude",
              "tieBreakRule": "rejected"
            },
            "quorumRequired": true,
            "quorumRule": "50%+1 of members present or represented",
            "allowDecideWithoutVote": false
          },
          {
            "@self": {
              "register": "decidesk",
              "schema": "ProcessTemplate",
              "slug": "association-board"
            },
            "name": "Association Board",
            "description": "Decision process for an association board (bestuur).",
            "context": "association",
            "builtIn": true,
            "initialState": "draft",
            "stateMachine": {
              "states": [
                { "name": "draft" },
                { "name": "proposed" },
                { "name": "deliberating" },
                { "name": "voting" },
                { "name": "decided" },
                { "name": "enacted" },
                { "name": "archived" }
              ],
              "transitions": [
                { "name": "propose", "from": "draft", "to": "proposed" },
                { "name": "deliberate", "from": "proposed", "to": "deliberating" },
                { "name": "openVoting", "from": "deliberating", "to": "voting", "chairOnly": true, "guards": ["quorum_met"] },
                { "name": "decide", "from": "voting", "to": "decided" },
                { "name": "enact", "from": "decided", "to": "enacted" },
                { "name": "archive", "from": "enacted", "to": "archived" }
              ]
            },
            "votingRule": {
              "voteThreshold": "simple-majority",
              "abstentionHandling": "exclude",
              "tieBreakRule": "chair-decides"
            },
            "quorumRequired": true,
            "quorumRule": "Majority of board members present",
            "allowDecideWithoutVote": false
          },
          {
            "@self": {
              "register": "decidesk",
              "schema": "ProcessTemplate",
              "slug": "corporate-board"
            },
            "name": "Corporate Board (BV)",
            "description": "Decision process for the management board of a Dutch private limited company (BV).",
            "context": "corporate",
            "builtIn": true,
            "initialState": "draft",
            "stateMachine": {
              "states": [
                { "name": "draft" },
                { "name": "proposed" },
                { "name": "deliberating" },
                { "name": "voting" },
                { "name": "decided" },
                { "name": "enacted" },
                { "name": "archived" }
              ],
              "transitions": [
                { "name": "propose", "from": "draft", "to": "proposed" },
                { "name": "deliberate", "from": "proposed", "to": "deliberating" },
                { "name": "openVoting", "from": "deliberating", "to": "voting", "chairOnly": true, "guards": ["quorum_met"] },
                { "name": "decide", "from": "voting", "to": "decided" },
                { "name": "enact", "from": "decided", "to": "enacted" },
                { "name": "archive", "from": "enacted", "to": "archived" }
              ]
            },
            "votingRule": {
              "voteThreshold": "simple-majority",
              "abstentionHandling": "exclude",
              "tieBreakRule": "chair-decides"
            },
            "quorumRequired": true,
            "quorumRule": "Quorum per the articles of association",
            "allowDecideWithoutVote": false
          },
          {
            "@self": {
              "register": "decidesk",
              "schema": "ProcessTemplate",
              "slug": "municipal-council"
            },
            "name": "Municipal Council",
            "description": "Legislative decision process for a municipal council (gemeenteraad), Gemeentewet.",
            "context": "legislative",
            "builtIn": true,
            "initialState": "draft",
            "stateMachine": {
              "states": [
                { "name": "draft" },
                { "name": "proposed" },
                { "name": "deliberating" },
                { "name": "voting" },
                { "name": "decided" },
                { "name": "enacted" },
                { "name": "archived" }
              ],
              "transitions": [
                { "name": "propose", "from": "draft", "to": "proposed" },
                { "name": "deliberate", "from": "proposed", "to": "deliberating" },
                { "name": "openVoting", "from": "deliberating", "to": "voting", "chairOnly": true, "guards": ["quorum_met", "all_amendments_resolved"] },
                { "name": "decide", "from": "voting", "to": "decided", "chairOnly": true },
                { "name": "enact", "from": "decided", "to": "enacted" },
                { "name": "archive", "from": "enacted", "to": "archived" }
              ]
            },
            "votingRule": {
