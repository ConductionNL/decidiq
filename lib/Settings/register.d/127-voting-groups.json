        "version": "0.1.0",
        "title": "Voting group",
        "description": "A fixed set of members of one body that the chair can pick when a voting round opens.",
        "type": "object",
        "x-openregister": {
          "active": true,
          "hardDelete": false,
          "searchable": false,
