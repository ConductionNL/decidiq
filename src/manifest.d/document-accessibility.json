{
	"$schema": "https://github.com/ConductionNL/nextcloud-vue/raw/main/src/schemas/app-manifest-v2.schema.json",
	"_note": "Document accessibility check (document-accessibility-check REQ-005): the per-body report as declarative pages over the accessibility-scan-report schema, reached from the Reports page card (ADR-112: no menu entry). Counts come from OpenRegister's aggregation endpoint (scalar equality filters only); the per-body and per-period split is the index page's facets and quick filters, and its mass export is the CSV. Schema ref BY SLUG.",
	"pages": [
		{
			"id": "AccessibilityReport",
			"route": "/reports/accessibility",
			"type": "dashboard",
			"title": "Document accessibility",
			"_note": "spec: openspec/changes/document-accessibility-check/specs/document-accessibility-check/spec.md#requirement-req-005-aggregate-accessibility-report-per-body-and-period. The body picker and the period range write the page workspace (governanceBody, dateFrom, dateTo); every tile, its share caption and the override count read it, so the report is per body and period. Overrides are counted from accessibility-override records, one per publication past the gate. The CSV export is the one custom widget: the shared export has no room for the heuristic-scan statement the CSV must carry. Every status is a heuristic check result, not a PDF/UA conformance claim; the chart, the table and the export say so.",
			"config": {
				"widgets": [
					{
						"id": "a11y-body",
						"title": "Governance body",
						"type": "workspace-filter",
						"content": {
							"writes": "@workspace.governanceBody",
							"label": "Governance body",
							"allLabel": "All bodies",
							"objectSource": {
								"register": "decidiq",
								"schema": "governance-body",
								"labelField": "name",
								"placeholder": "All bodies",
								"ariaLabel": "Governance body"
							}
						}
					},
					{
						"id": "a11y-pass",
						"title": "Passed",
						"type": "stat",
						"content": {
							"label": "Passed",
							"icon": "CheckCircleOutline",
							"route": {
								"name": "AccessibilityScanReports"
							},
							"format": {
								"style": "decimal",
								"decimals": 0
							},
							"source": {
								"register": "decidiq",
								"schema": "accessibility-scan-report",
								"metric": "count",
								"filter": {
									"governanceBody": "@workspace.governanceBody?",
									"scannedAt": {
										"gte": "@workspace.dateFrom?",
										"lte": "@workspace.dateTo?"
									},
									"status": "pass"
								}
							},
							"caption": "{ratio}% of checked documents",
							"captionSource": {
								"kind": "ratio",
								"denominator": {
									"filter": {
										"governanceBody": "@workspace.governanceBody?",
										"scannedAt": {
											"gte": "@workspace.dateFrom?",
											"lte": "@workspace.dateTo?"
										}
									}
								},
								"decimals": 0
							}
						}
					},
					{
						"id": "a11y-warnings",
						"title": "With warnings",
						"type": "stat",
						"content": {
							"label": "With warnings",
							"icon": "AlertOutline",
							"route": {
								"name": "AccessibilityScanReports"
							},
							"format": {
								"style": "decimal",
								"decimals": 0
							},
							"source": {
								"register": "decidiq",
								"schema": "accessibility-scan-report",
								"metric": "count",
								"filter": {
									"governanceBody": "@workspace.governanceBody?",
									"scannedAt": {
										"gte": "@workspace.dateFrom?",
										"lte": "@workspace.dateTo?"
									},
									"status": "warnings"
								}
							},
							"caption": "{ratio}% of checked documents",
							"captionSource": {
								"kind": "ratio",
								"denominator": {
									"filter": {
										"governanceBody": "@workspace.governanceBody?",
										"scannedAt": {
											"gte": "@workspace.dateFrom?",
											"lte": "@workspace.dateTo?"
										}
									}
								},
								"decimals": 0
							}
						}
					},
					{
						"id": "a11y-fail",
						"title": "Failed",
						"type": "stat",
						"content": {
							"label": "Failed",
							"icon": "AlertOctagonOutline",
							"route": {
								"name": "AccessibilityScanReports"
							},
							"format": {
								"style": "decimal",
								"decimals": 0
							},
							"source": {
								"register": "decidiq",
								"schema": "accessibility-scan-report",
								"metric": "count",
								"filter": {
									"governanceBody": "@workspace.governanceBody?",
									"scannedAt": {
										"gte": "@workspace.dateFrom?",
										"lte": "@workspace.dateTo?"
									},
									"status": "fail"
								}
							},
							"caption": "{ratio}% of checked documents",
							"captionSource": {
								"kind": "ratio",
								"denominator": {
									"filter": {
										"governanceBody": "@workspace.governanceBody?",
										"scannedAt": {
											"gte": "@workspace.dateFrom?",
											"lte": "@workspace.dateTo?"
										}
									}
								},
								"decimals": 0
							}
						}
					},
					{
						"id": "a11y-not-scanned",
						"title": "Not checked",
						"type": "stat",
						"content": {
							"label": "Not checked",
							"icon": "FileDocumentOutline",
							"route": {
								"name": "AccessibilityScanReports"
							},
							"format": {
								"style": "decimal",
								"decimals": 0
							},
							"source": {
								"register": "decidiq",
								"schema": "accessibility-scan-report",
								"metric": "count",
								"filter": {
									"governanceBody": "@workspace.governanceBody?",
									"scannedAt": {
										"gte": "@workspace.dateFrom?",
										"lte": "@workspace.dateTo?"
									},
									"status": "not-scanned"
								}
							},
							"caption": "{ratio}% of checked documents",
							"captionSource": {
								"kind": "ratio",
								"denominator": {
									"filter": {
										"governanceBody": "@workspace.governanceBody?",
										"scannedAt": {
											"gte": "@workspace.dateFrom?",
											"lte": "@workspace.dateTo?"
										}
									}
								},
								"decimals": 0
							}
						}
					},
					{
						"id": "a11y-overrides",
						"title": "Published past the check",
						"type": "stat",
						"content": {
							"label": "Published past the check",
							"icon": "ShieldAlertOutline",
							"format": {
								"style": "decimal",
								"decimals": 0
							},
							"source": {
								"register": "decidiq",
								"schema": "accessibility-override",
								"metric": "count",
								"filter": {
									"governanceBody": "@workspace.governanceBody?",
									"overriddenAt": {
										"gte": "@workspace.dateFrom?",
										"lte": "@workspace.dateTo?"
									}
								}
							}
						}
					},
					{
						"id": "a11y-by-status",
						"title": "By result of the heuristic check",
						"type": "chart",
						"content": {
							"chartKind": "donut",
							"legendPosition": "bottom",
							"emptyLabel": "No documents checked yet",
							"dataSource": {
								"register": "decidiq",
								"schema": "accessibility-scan-report",
								"aggregate": {
									"groupBy": "status",
									"metric": "count"
								},
								"filter": {
									"governanceBody": "@workspace.governanceBody?"
								}
							}
						},
						"_note": "Per body, over all time: the grouped aggregation applies equality filters only, so a period bound would be silently ignored here. The tiles above carry the period."
					},
					{
						"id": "a11y-failing",
						"title": "Documents that failed the heuristic check",
						"type": "object-table",
						"content": {
							"register": "decidiq",
							"schema": "accessibility-scan-report",
							"filter": {
								"governanceBody": "@workspace.governanceBody?",
								"scannedAt": {
									"gte": "@workspace.dateFrom?",
									"lte": "@workspace.dateTo?"
								},
								"status": "fail"
							},
							"sort": {
								"field": "scannedAt",
								"dir": "desc"
							},
							"limit": 8,
							"emptyText": "No document failed the check",
							"viewAllRoute": {
								"name": "AccessibilityScanReports"
							},
							"viewAllLabel": "View all checked documents",
							"columns": [
								{
									"key": "fileName",
									"label": "File name"
								},
								{
									"key": "scannedAt",
									"label": "Scanned at"
								}
							]
						}
					},
					{
						"id": "a11y-export",
						"title": "Export",
						"type": "accessibility-report-export",
						"content": {
							"register": "decidiq",
							"schema": "accessibility-scan-report",
							"filter": {
								"governanceBody": "@workspace.governanceBody?",
								"scannedAt": {
									"gte": "@workspace.dateFrom?",
									"lte": "@workspace.dateTo?"
								}
							},
							"overrides": {
								"schema": "accessibility-override",
								"filter": {
									"governanceBody": "@workspace.governanceBody?",
									"overriddenAt": {
										"gte": "@workspace.dateFrom?",
										"lte": "@workspace.dateTo?"
									}
								}
							},
							"bodySchema": "governance-body",
							"fileName": "accessibility-report.csv"
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "a11y-body",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 6,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "2",
						"widgetId": "a11y-overrides",
						"gridX": 6,
						"gridY": 0,
						"gridWidth": 6,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "3",
						"widgetId": "a11y-pass",
						"gridX": 0,
						"gridY": 2,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "4",
						"widgetId": "a11y-warnings",
						"gridX": 3,
						"gridY": 2,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "5",
						"widgetId": "a11y-fail",
						"gridX": 6,
						"gridY": 2,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "6",
						"widgetId": "a11y-not-scanned",
						"gridX": 9,
						"gridY": 2,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": false
					},
					{
						"id": "7",
						"widgetId": "a11y-by-status",
						"gridX": 0,
						"gridY": 4,
						"gridWidth": 4,
						"gridHeight": 4,
						"showTitle": true
					},
					{
						"id": "8",
						"widgetId": "a11y-failing",
						"gridX": 4,
						"gridY": 4,
						"gridWidth": 8,
						"gridHeight": 4,
						"showTitle": true
					},
					{
						"id": "9",
						"widgetId": "a11y-export",
						"gridX": 0,
						"gridY": 8,
						"gridWidth": 12,
						"gridHeight": 2,
						"showTitle": true
					}
				],
				"dateRange": {
					"enabled": true,
					"persistKey": "decidiq.accessibility-report.range",
					"default": {
						"preset": "all"
					},
					"presets": [
						{
							"id": "last-30",
							"label": "30d",
							"days": 30
						},
						{
							"id": "last-90",
							"label": "90d",
							"days": 90
						},
						{
							"id": "last-365",
							"label": "1y",
							"days": 365
						},
						{
							"id": "all",
							"label": "All",
							"days": null
						},
						{
							"id": "custom",
							"label": "Custom range"
						}
					]
				}
			}
		},
		{
			"id": "AccessibilityScanReports",
			"route": "/reports/accessibility/documents",
			"type": "index",
			"title": "Checked documents",
			"_note": "spec: openspec/changes/document-accessibility-check/specs/document-accessibility-check/spec.md#requirement-req-005-aggregate-accessibility-report-per-body-and-period. The body and the period are the sidebar facets (governanceBody, scannedAt); the mass export is the CSV of the same rows. Reports are written by the scan only, so the index is read only.",
			"config": {
				"register": "decidiq",
				"schema": "accessibility-scan-report",
				"readOnly": true,
				"sortKey": "scannedAt",
				"sortOrder": "desc",
				"quickFilterMode": "dropdown",
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true
					},
					{
						"label": "Passed",
						"filter": {
							"status": "pass"
						}
					},
					{
						"label": "With warnings",
						"filter": {
							"status": "warnings"
						}
					},
					{
						"label": "Failed",
						"filter": {
							"status": "fail"
						}
					},
					{
						"label": "Not checked",
						"filter": {
							"status": "not-scanned"
						}
					}
				],
				"columns": [
					{
						"key": "fileName",
						"label": "File name",
						"widget": "link"
					},
					{
						"key": "governanceBody",
						"label": "Governance body",
						"widget": "fkResolve",
						"widgetProps": {
							"register": "decidiq",
							"schema": "governance-body",
							"labelField": "name"
						}
					},
					{
						"key": "status",
						"label": "Status",
						"widget": "badge"
					},
					{
						"key": "scannedAt",
						"label": "Scanned at"
					}
				],
				"actions": [
					{
						"id": "view",
						"label": "View",
						"icon": "EyeOutline",
						"handler": "navigate",
						"route": "AccessibilityScanReportDetail",
						"primary": true
					}
				],
				"showMassExport": true,
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://decidiq.conduction.nl"
			}
		},
		{
			"id": "AccessibilityScanReportDetail",
			"route": "/reports/accessibility/documents/:id",
			"type": "detail",
			"title": "Checked document",
			"_note": "spec: openspec/changes/document-accessibility-check/specs/document-accessibility-check/spec.md#requirement-req-004-remediation-guidance-per-finding. One report: the status, the findings with what was seen, and which file and body it is about. A report is a snapshot, so the page is read only.",
			"config": {
				"register": "decidiq",
				"schema": "accessibility-scan-report",
				"readOnly": true,
				"widgets": [
					{
						"id": "a11y-report-data",
						"type": "data",
						"title": "Data",
						"icon": "FileDocumentCheckOutline",
						"content": {
							"columns": 2,
							"include": [
								"fileName",
								"status",
								"findings",
								"governanceBody",
								"sourceObject",
								"scannedAt",
								"pageCount",
								"mimeType",
								"scannerVersion",
								"heuristic"
							]
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "a11y-report-data",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 6
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{
							"id": "audit",
							"label": "History",
							"icon": "History",
							"widgets": [
								{
									"type": "audit"
								}
							]
						}
					]
				},
				"documentationUrl": "https://decidiq.conduction.nl"
			}
		}
	]
}
