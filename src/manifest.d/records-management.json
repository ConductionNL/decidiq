{
	"$schema": "https://github.com/ConductionNL/nextcloud-vue/raw/main/src/schemas/app-manifest-v2.schema.json",
	"_note": "records-management-archiving (pub-11, pub-18), task 6: the archive dashboard, the dossier index and the dossier detail with its route panel. Schema ref by slug (archival-dossier). The menu entry is relocated into Registers by src/menu-layout.json. Counters are stat widgets over the dossier's own lifecycle and disposition; the overdue-transfer and unresolved-retention counters read OpenRegister's retention block through @self path filters (openregister#11047) and count through the list total. The meeting-without-dossier counter still waits: it is absence across two schemas (an anti-join), which no filter expresses (design.md, Corrections).",
	"menu": [
		{
			"id": "Archive",
			"label": "Archive",
			"icon": "ArchiveOutline",
			"route": "ArchiveDashboard",
			"order": 92
		}
	],
	"pages": [
		{
			"id": "ArchiveDashboard",
			"route": "/archive",
			"type": "dashboard",
			"title": "Archive",
			"config": {
				"widgets": [
					{ "id": "dossiers-forming", "type": "stat", "title": "Forming", "content": { "label": "Forming", "icon": "ArchiveOutline", "route": { "name": "ArchivalDossiers", "query": { "lifecycle": "forming" } }, "format": { "style": "decimal", "decimals": 0 }, "source": { "register": "decidiq", "schema": "archival-dossier", "metric": "count", "filter": { "lifecycle": "forming" } } } },
					{ "id": "dossiers-closed", "type": "stat", "title": "Closed", "content": { "label": "Closed", "icon": "ArchiveCheckOutline", "route": { "name": "ArchivalDossiers", "query": { "lifecycle": "closed" } }, "format": { "style": "decimal", "decimals": 0 }, "source": { "register": "decidiq", "schema": "archival-dossier", "metric": "count", "filter": { "lifecycle": "closed" } } } },
					{ "id": "dossiers-awaiting-transfer", "type": "stat", "title": "Waiting for transfer", "content": { "label": "Waiting for transfer", "icon": "ArchiveArrowUpOutline", "variant": "warning", "route": { "name": "ArchivalDossiers", "query": { "lifecycle": "closed", "disposition": "transfer" } }, "format": { "style": "decimal", "decimals": 0 }, "source": { "register": "decidiq", "schema": "archival-dossier", "metric": "count", "filter": { "lifecycle": "closed", "disposition": "transfer" } } } },
					{ "id": "dossiers-awaiting-destruction", "type": "stat", "title": "On a destruction list", "content": { "label": "On a destruction list", "icon": "DeleteClockOutline", "variant": "warning", "route": { "name": "ArchivalDossiers", "query": { "lifecycle": "closed", "disposition": "destruction" } }, "format": { "style": "decimal", "decimals": 0 }, "source": { "register": "decidiq", "schema": "archival-dossier", "metric": "count", "filter": { "lifecycle": "closed", "disposition": "destruction" } } } },
					{ "id": "dossiers-transferred", "type": "stat", "title": "Transferred", "content": { "label": "Transferred", "icon": "ArchiveArrowUpOutline", "route": { "name": "ArchivalDossiers", "query": { "lifecycle": "transferred" } }, "format": { "style": "decimal", "decimals": 0 }, "source": { "register": "decidiq", "schema": "archival-dossier", "metric": "count", "filter": { "lifecycle": "transferred" } } } },
					{ "id": "dossiers-destroyed", "type": "stat", "title": "Destroyed", "content": { "label": "Destroyed", "icon": "DeleteClockOutline", "route": { "name": "ArchivalDossiers", "query": { "lifecycle": "destroyed" } }, "format": { "style": "decimal", "decimals": 0 }, "source": { "register": "decidiq", "schema": "archival-dossier", "metric": "count", "filter": { "lifecycle": "destroyed" } } } },
					{ "id": "dossiers-transfer-overdue", "type": "stat", "title": "Transfer overdue", "_note": "records-management-archiving task 6 (REQ-RMA-007): closed dossiers routed to transfer whose archive action date, as OpenRegister resolved it into the retention block, lies before today. The date is read where OpenRegister writes it (@self retention.archiefactiedatum, openregister#11047); decidiq computes no date. `via: list` counts through the list total, which understands the operator and resolves @today.", "content": { "label": "Transfer overdue", "icon": "ArchiveAlertOutline", "variant": "error", "route": { "name": "ArchivalDossiers", "query": { "lifecycle": "closed", "disposition": "transfer", "@self.retention.archiefactiedatum[lt]": "@today" } }, "format": { "style": "decimal", "decimals": 0 }, "source": { "register": "decidiq", "schema": "archival-dossier", "metric": "count", "via": "list", "filter": { "lifecycle": "closed", "disposition": "transfer", "@self.retention.archiefactiedatum": { "lt": "@today" } } } } },
					{ "id": "dossiers-retention-unresolved", "type": "stat", "title": "Retention not resolved", "_note": "records-management-archiving task 6 (REQ-RMA-007): dossiers for which OpenRegister resolved no archive nomination, so no retention applies yet (a missing or unknown selection-list category). Read from @self retention.archiefnominatie (openregister#11047) with the isnull operator, through the list total.", "content": { "label": "Retention not resolved", "icon": "ArchiveCancelOutline", "variant": "warning", "route": { "name": "ArchivalDossiers", "query": { "@self.retention.archiefnominatie[isnull]": "true" } }, "format": { "style": "decimal", "decimals": 0 }, "source": { "register": "decidiq", "schema": "archival-dossier", "metric": "count", "via": "list", "filter": { "@self.retention.archiefnominatie": { "isnull": true } } } } },
					{ "id": "meetings-without-dossier", "type": "stat", "title": "Meetings without dossier", "_note": "records-management-archiving task 6 (REQ-RMA-007): closed meetings for which no archival dossier was formed, an archiving gap. A meeting names its dossier (archivalDossier, fragment 144, written when the dossier is formed and once for existing dossiers by FillMeetingArchivalDossier), so the gap is one isnull filter on one schema, counted through the list total.", "content": { "label": "Meetings without dossier", "icon": "FolderAlertOutline", "variant": "warning", "route": { "name": "Meetings", "query": { "lifecycle": "closed", "archivalDossier[isnull]": "true" } }, "format": { "style": "decimal", "decimals": 0 }, "source": { "register": "decidiq", "schema": "meeting", "metric": "count", "via": "list", "filter": { "lifecycle": "closed", "archivalDossier": { "isnull": true } } } } },
					{ "id": "archive-ready-for-destruction", "type": "object-list", "title": "Ready for destruction", "icon": "DeleteClockOutline", "content": { "register": "decidiq", "schema": "archival-dossier", "filter": { "lifecycle": "closed", "disposition": "destruction" }, "sort": { "field": "closedAt", "dir": "asc" }, "columns": [{ "key": "title", "label": "Title" }, { "key": "governanceBody", "label": "Body" }, { "key": "closedAt", "label": "Closed" }, { "key": "selectielijstCategorie", "label": "Selection list category" }], "limit": 10, "allowCreate": false, "rowRoute": "ArchivalDossierDetail" } },
					{ "id": "archive-disposed", "type": "object-list", "title": "Destroyed and transferred", "icon": "ArchiveArrowUpOutline", "content": { "register": "decidiq", "schema": "archival-dossier", "filter": { "lifecycle": ["destroyed", "transferred"] }, "sort": { "field": "closedAt", "dir": "desc" }, "columns": [{ "key": "title", "label": "Title" }, { "key": "lifecycle", "label": "Status", "widget": "badge" }, { "key": "closedBy", "label": "Closed by" }, { "key": "closedAt", "label": "Closed" }], "limit": 10, "allowCreate": false, "rowRoute": "ArchivalDossierDetail" } },
					{ "id": "archive-log", "type": "audit-trail", "title": "Log", "icon": "History", "content": { "scope": "app", "register": "decidiq", "maxDisplay": 20 } }
				],
				"layout": [
					{ "id": "1", "widgetId": "dossiers-forming", "gridX": 0, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "2", "widgetId": "dossiers-closed", "gridX": 4, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "3", "widgetId": "dossiers-awaiting-transfer", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "4", "widgetId": "dossiers-awaiting-destruction", "gridX": 0, "gridY": 2, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "5", "widgetId": "dossiers-transferred", "gridX": 4, "gridY": 2, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "6", "widgetId": "dossiers-destroyed", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "10", "widgetId": "dossiers-transfer-overdue", "gridX": 0, "gridY": 4, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "11", "widgetId": "dossiers-retention-unresolved", "gridX": 4, "gridY": 4, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "12", "widgetId": "meetings-without-dossier", "gridX": 8, "gridY": 4, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "7", "widgetId": "archive-ready-for-destruction", "gridX": 0, "gridY": 6, "gridWidth": 12, "gridHeight": 4 },
					{ "id": "8", "widgetId": "archive-disposed", "gridX": 0, "gridY": 10, "gridWidth": 12, "gridHeight": 4 },
					{ "id": "9", "widgetId": "archive-log", "gridX": 0, "gridY": 14, "gridWidth": 12, "gridHeight": 5 }
				]
			}
		},
		{
			"id": "ArchivalDossiers",
			"route": "/archive/dossiers",
			"type": "index",
			"title": "Archival dossiers",
			"config": {
				"register": "decidiq",
				"schema": "archival-dossier",
				"sortKey": "assembledAt",
				"sortOrder": "desc",
				"quickFilterMode": "dropdown",
				"quickFilters": [
					{ "label": "All", "filter": {}, "default": true },
					{ "label": "Forming", "filter": { "lifecycle": "forming" } },
					{ "label": "Closed", "filter": { "lifecycle": "closed" } },
					{ "label": "Transferred", "filter": { "lifecycle": "transferred" } },
					{ "label": "Destroyed", "filter": { "lifecycle": "destroyed" } },
					{ "label": "Transfer overdue", "filter": { "lifecycle": "closed", "disposition": "transfer", "@self.retention.archiefactiedatum": { "lt": "@today" } } },
					{ "label": "Retention not resolved", "filter": { "@self.retention.archiefnominatie": { "isnull": true } } }
				],
				"columns": [
					{ "key": "title", "label": "Title", "widget": "link" },
					{ "key": "meeting", "label": "Meeting", "widget": "fkResolve", "widgetProps": { "register": "decidiq", "schema": "meeting", "labelField": "title" } },
					{ "key": "lifecycle", "label": "Stage", "widget": "badge" },
					{ "key": "disposition", "label": "Route", "widget": "badge" },
					{ "key": "securityClassification", "label": "Security classification", "widget": "badge" }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "ArchivalDossierDetail", "primary": true }
				],
				"sidebar": { "enabled": true, "showMetadata": true },
				"documentationUrl": "https://decidiq.conduction.nl"
			}
		},
		{
			"id": "ArchivalDossierDetail",
			"route": "/archive/dossiers/:id",
			"type": "detail",
			"title": "Archival dossier",
			"slots": {
				"widget-dossier-disposition": "DossierDispositionPanel"
			},
			"config": {
				"register": "decidiq",
				"schema": "archival-dossier",
				"widgets": [
					{ "id": "dossier-data", "type": "data", "title": "Archival dossier", "icon": "ArchiveOutline", "content": { "columns": 2 } },
					{ "id": "dossier-disposition", "type": "custom", "component": "DossierDispositionPanel", "title": "Archive route", "icon": "ArchiveArrowUpOutline" },
					{ "id": "dossier-related", "type": "related", "title": "Related", "icon": "LinkVariant" }
				],
				"layout": [
					{ "id": "1", "widgetId": "dossier-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 8 },
					{ "id": "2", "widgetId": "dossier-disposition", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 5 },
					{ "id": "3", "widgetId": "dossier-related", "gridX": 8, "gridY": 5, "gridWidth": 4, "gridHeight": 3 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				},
				"documentationUrl": "https://decidiq.conduction.nl"
			}
		}
	]
}
