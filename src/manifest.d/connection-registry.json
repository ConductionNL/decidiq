{
	"$schema": "https://github.com/ConductionNL/nextcloud-vue/raw/main/src/schemas/app-manifest-v2.schema.json",
	"_note": "adopt-connection-registry (hydra connection-registry D8, hydra#667 and hydra#673). The rows are integriq's `app_connection` objects, synced from lib/Settings/connections.json; integriq works out each status. The app=decidiq preset is the menu entry's `query` (ADR-097 decision 5), which the index page merges into the fetch as a bare filter key. The ids are ConnectionRegistry, not Integrations, so they never collide with the per-object integration pages such as MotionIntegrations. `showAdd` is false because a row nothing declared has nothing to check (D9). Add integration leaves for integriq's overview through the openIntegriqConnections handler, because a header action's `navigate` only pushes a route inside this app.",
	"menu": [
		{
			"id": "ConnectionRegistryMenu",
			"label": "Integrations",
			"icon": "PowerPlugOutline",
			"route": "ConnectionRegistry",
			"query": {
				"app": "decidiq"
			},
			"section": "settings",
			"order": 97,
			"permission": "admin",
			"visibleIf": {
				"appInstalled": "integriq"
			}
		}
	],
	"pages": [
		{
			"id": "ConnectionRegistry",
			"route": "/settings/integrations",
			"type": "index",
			"title": "Integrations",
			"permission": "admin",
			"requiresApp": {
				"id": "integriq",
				"name": "Integriq"
			},
			"config": {
				"register": "integriq",
				"schema": "app_connection",
				"showViewAction": false,
				"showAdd": false,
				"headerActions": [
					{
						"id": "add-integration",
						"label": "Add integration",
						"icon": "PowerPlugOutline",
						"handler": "openIntegriqConnections"
					}
				],
				"defaultSort": {
					"field": "order",
					"direction": "asc"
				},
				"columns": [
					{
						"key": "title",
						"label": "Connection"
					},
					{
						"key": "status",
						"label": "Status",
						"formatter": "connectionStatus"
					},
					{
						"key": "statusMessage",
						"label": "Status message",
						"sortable": false
					},
					{
						"key": "checkedAt",
						"label": "Last checked"
					},
					{
						"key": "settingsUrl",
						"label": "Settings",
						"sortable": false,
						"formatter": "connectionSettingsLabel",
						"widget": "link",
						"widgetProps": {
							"href": "{settingsUrl}"
						}
					}
				],
				"folderSidebar": {
					"source": "field",
					"field": "status",
					"allLabel": "All connections"
				}
			}
		}
	]
}
