{
	"$schema": "https://codeberg.org/Conduction/nextcloud-vue/raw/branch/main/src/schemas/app-manifest-v2.schema.json",
	"_note": "Consultations & engagement hub (consultations-engagement-hub) — appended onto the bundled src/manifest.json by main.js::mergeManifestFragments (ADR-037). Collapses the former Participation / Consultations / Participatory budgets leaves into ONE Consultations hub (typed via consultationType quick-filters), keeps the hub-wide Moderation queue, and folds reaction moderation into the consultation detail via the shared ConsultationReactionsTab. The Participation action page and BudgetRounds pages are retained but reachable from the hub rather than as top-level peers.",
	"_spec": "openspec/changes/consultations-engagement-hub/specs/p3-citizen-participation/spec.md",
	"menu": [
		{
			"id": "Consultations",
			"label": "Consultations",
			"icon": "icon-comment",
			"route": "Consultations",
			"order": 66
		},
		{
			"id": "ModerationQueue",
			"label": "Moderation queue",
			"icon": "icon-checkmark",
			"route": "ModerationQueue",
			"order": 68
		}
	],
	"pages": [
		{
			"id": "Participation",
			"route": "/participation",
			"type": "custom",
			"title": "Citizen participation",
			"_note": "Citizen-facing surface of an open consultation; reachable from the hub, not a top-level menu peer.",
			"_spec": "openspec/changes/consultations-engagement-hub/specs/p3-citizen-participation/spec.md",
			"component": "ParticipationPage"
		},
		{
			"id": "Consultations",
			"route": "/consultations",
			"type": "index",
			"title": "Consultations",
			"config": {
				"register": "decidesk",
				"schema": "public-consultation",
				"quickFilterMode": "dropdown",
				"quickFilterMultiple": true,
				"quickFilters": [
					{
						"label": "All",
						"filter": {},
						"default": true
					},
					{
						"label": "Citizen participation",
						"filter": {
							"consultationType": "citizen-participation"
						}
					},
					{
						"label": "Market consultations",
						"filter": {
							"consultationType": "market-consultation"
						}
					},
					{
						"label": "Tenders",
						"filter": {
							"consultationType": "tender"
						}
					},
					{
						"label": "Idea box",
						"filter": {
							"consultationType": "idea-box"
						}
					},
					{
						"label": "Participatory budgets",
						"filter": {
							"consultationType": "participatory-budget"
						},
						"page": "BudgetRounds",
						"route": "BudgetRounds"
					}
				],
				"_quickFiltersNote": "consultationType is a stored/queryable field on the PublicConsultation supertype (consultations-engagement-hub), so each tab merges a server-side filter into the OpenRegister fetch — the proven Decisions/Motions decisionType pattern. Participatory budgets additionally deep-links to the retained BudgetRounds page for the legacy budget flow during migration.",
				"columns": [
					{
						"key": "title",
						"label": "Title",
						"widget": "link"
					},
					{
						"key": "consultationType",
						"label": "Type",
						"widget": "badge"
					},
					{
						"key": "status",
						"label": "Status",
						"widget": "badge"
					},
					"submissionDeadline"
				],
				"actions": [
					{
						"id": "view",
						"label": "View",
						"icon": "icon-toggle",
						"handler": "navigate",
						"route": "ConsultationDetail",
						"primary": true
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "ConsultationDetail",
			"route": "/consultations/:id",
			"type": "detail",
			"title": "Consultation",
			"config": {
				"register": "decidesk",
				"schema": "public-consultation",
				"relatedCollections": [
					{
						"title": "Reactions",
						"register": "decidesk",
						"schema": "consultation-reaction",
						"filter": {
							"_relations.public-consultation": "@objectId"
						},
						"columns": [
							{
								"key": "body",
								"label": "Reaction"
							},
							{
								"key": "moderationStatus",
								"label": "Status",
								"widget": "badge"
							},
							"submitterId",
							"submittedAt"
						],
						"sort": {
							"key": "submittedAt",
							"order": "desc"
						},
						"limit": 50
					}
				],
				"_relatedCollectionsNote": "Reactions (the consultation's submissions) are related through OpenRegister (PublicConsultation.reactions one-to-many <-> ConsultationReaction.consultation many-to-one) and render as a table on the main detail body — moved off the former Reactions sidebar tab. Hub-wide pending moderation still uses ConsultationReactionsTab on the Moderation queue.",
				"sidebarTabs": [
					{
						"id": "overview",
						"label": "Overview",
						"icon": "icon-info",
						"widgets": [
							{
								"type": "data"
							},
							{
								"type": "metadata"
							}
						],
						"order": 10
					},
					{
						"id": "audit",
						"label": "Audit trail",
						"icon": "icon-history",
						"widgets": [
							{
								"type": "audit-trail"
							}
						],
						"order": 90
					}
				],
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "BudgetRounds",
			"route": "/budget-rounds",
			"type": "index",
			"title": "Participatory budgets",
			"_note": "Retained transitional view for the legacy participatory-budget flow; reachable from the Consultations hub Participatory budgets quick-filter, not a top-level menu peer.",
			"config": {
				"register": "decidesk",
				"schema": "participatory-budget",
				"columns": [
					"name",
					"totalAmount",
					"currency",
					"status"
				],
				"actions": [
					{
						"id": "view",
						"label": "View",
						"icon": "icon-toggle",
						"handler": "navigate",
						"route": "BudgetRoundDetail",
						"primary": true
					}
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "BudgetRoundDetail",
			"route": "/budget-rounds/:id",
			"type": "detail",
			"title": "Participatory budget",
			"config": {
				"register": "decidesk",
				"schema": "participatory-budget"
			}
		},
		{
			"id": "ModerationQueue",
			"route": "/moderation-queue",
			"type": "custom",
			"title": "Moderation queue",
			"_spec": "openspec/changes/consultations-engagement-hub/specs/p3-citizen-participation/spec.md",
			"component": "ModerationQueuePage"
		}
	]
}
