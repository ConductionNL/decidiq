{
	"$schema": "https://codeberg.org/Conduction/nextcloud-vue/raw/branch/main/src/schemas/app-manifest-v2.schema.json",
	"_note": "Shared governance bodies (gemeenschappelijke regeling per Wgr) — appended onto the bundled src/manifest.json by main.js::mergeManifestFragments (ADR-037). Zienswijzerondes index + ronde detail, and a zienswijzen index; schema refs BY SLUG (zienswijzeronde / zienswijze / body-participation), never the PascalCase keys (multi-word schemas — the exact silent-breakage case). The 'Deelnemende organisaties' section on GovernanceBodyDetail and the 'Openstaande zienswijzen' Dashboard stat widget live in the base src/manifest.json (design D6/REQ-SGB-010: mergePages replaces a same-id page wholesale, so a fragment cannot add one section/widget to an existing page without redefining it) — out of scope for this declarative-core fragment. Object creation on ronde opening (fan-out of one zienswijze per active participation) is imperative (ZienswijzerondeService); this declarative fragment provides the page skeletons, quick filters, and the data + files + related widgets.",
	"_spec": "openspec/changes/shared-governance-bodies/specs/shared-governance-bodies/spec.md",
	"menu": [
		{
			"id": "Zienswijzerondes",
			"label": "Zienswijzerondes",
			"icon": "CommentQuestionOutline",
			"route": "Zienswijzerondes",
			"order": 76
		},
		{
			"id": "Zienswijzen",
			"label": "Zienswijzen",
			"icon": "CommentQuestionOutline",
			"route": "Zienswijzen",
			"order": 77
		}
	],
	"pages": [
		{
			"id": "Zienswijzerondes",
			"route": "/zienswijzerondes",
			"type": "index",
			"title": "Zienswijzerondes",
			"_note": "spec: openspec/changes/shared-governance-bodies/specs/shared-governance-bodies/spec.md#requirement-req-sgb-010-participation-and-zienswijze-views-plus-dashboard-kpi",
			"config": {
				"register": "decidesk",
				"schema": "zienswijzeronde",
				"sortKey": "@self.created",
				"sortOrder": "desc",
				"_note": "Zienswijzerondes list (REQ-SGB-010 (2)). Columns title/sharedBody/subjectType/deadline/status; quick filters on subjectType and status; filterable on sharedBody. Schema ref by slug (zienswijzeronde). CSV export via the shared ExportService + CnMassExportDialog.",
				"quickFilterMode": "dropdown",
				"quickFilterMultiple": true,
				"quickFilters": [
					{ "label": "All", "filter": {}, "default": true },
					{ "label": "Concept", "filter": { "status": "draft" } },
					{ "label": "Open", "filter": { "status": "opened" } },
					{ "label": "Processing", "filter": { "status": "processing" } },
					{ "label": "Closed", "filter": { "status": "completed" } },
					{ "label": "Withdrawn", "filter": { "status": "withdrawn" } },
					{ "label": "Ontwerpbegroting", "filter": { "subjectType": "draft-budget" } },
					{ "label": "Begrotingswijziging", "filter": { "subjectType": "budget-amendment" } },
					{ "label": "Kadernota", "filter": { "subjectType": "framework-memorandum" } },
					{ "label": "Jaarrekening", "filter": { "subjectType": "annual-accounts" } },
					{ "label": "Wijziging regeling", "filter": { "subjectType": "amendment-of-arrangement" } },
					{ "label": "Toetreding/uittreding", "filter": { "subjectType": "accession-withdrawal" } },
					{ "label": "Overig", "filter": { "subjectType": "other" } }
				],
				"columns": [
					{ "key": "title", "label": "Title", "widget": "link" },
					{ "key": "sharedBody", "label": "Shared body" },
					{ "key": "subjectType", "label": "Subject", "widget": "badge" },
					{ "key": "deadline", "label": "Deadline", "widget": "date" },
					{ "key": "status", "label": "Status", "widget": "badge" }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "ZienswijzerondeDetail", "primary": true }
				],
				"showMassExport": true,
				"sidebar": { "enabled": true, "showMetadata": true },
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "ZienswijzerondeDetail",
			"route": "/zienswijzerondes/:id",
			"type": "detail",
			"title": "Zienswijzeronde",
			"_note": "spec: openspec/changes/shared-governance-bodies/specs/shared-governance-bodies/spec.md#requirement-req-sgb-007-aggregated-zienswijzen-overview-and-verwerking-by-the-shared-body",
			"config": {
				"register": "decidesk",
				"schema": "zienswijzeronde",
				"_note": "ZienswijzerondeDetail (REQ-SGB-004/007). Ronde data leads 8-wide; the subject document(s) attach via the Files leaf (OR file abstraction). The Related widget surfaces the aggregated overview of all its Zienswijze objects (reverse lookup on ronde) with participant/status/standpunt/ingediendDatum/verwerking, plus the resolved sharedBody, cyclusStap (soft), and closing decision (vaststellingsbesluit) references — read from the declared x-openregister-relations, no bespoke aggregation endpoint. Status is declared in x-openregister-lifecycle. Audit trail is a sidebar tab. Schema ref by slug (zienswijzeronde).",
				"widgets": [
					{ "id": "ronde-data", "type": "data", "title": "Zienswijzeronde", "icon": "MessageTextOutline", "content": { "columns": 2 } },
					{ "id": "ronde-files", "type": "integration", "integrationId": "files", "title": "Subject documents", "icon": "FolderOutline" },
					{ "id": "ronde-related", "type": "related", "title": "Zienswijzen & references", "icon": "LinkVariant" }
				],
				"layout": [
					{ "id": "1", "widgetId": "ronde-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 6 },
					{ "id": "2", "widgetId": "ronde-files", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 6 },
					{ "id": "3", "widgetId": "ronde-related", "gridX": 0, "gridY": 6, "gridWidth": 12, "gridHeight": 4 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				},
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "Zienswijzen",
			"route": "/zienswijzen",
			"type": "index",
			"title": "Zienswijzen",
			"_note": "spec: openspec/changes/shared-governance-bodies/specs/shared-governance-bodies/spec.md#requirement-req-sgb-010-participation-and-zienswijze-views-plus-dashboard-kpi",
			"config": {
				"register": "decidesk",
				"schema": "zienswijze",
				"sortKey": "@self.created",
				"sortOrder": "desc",
				"_note": "Zienswijzen list (REQ-SGB-010 (3)). Filterable on participant organisation and status so each organisation sees its open zienswijze obligations; the Dashboard 'Openstaande zienswijzen' KPI (base src/manifest.json) deep-links here pre-filtered to the open set (status uitstaand/in-voorbereiding), where the participant filter gives the per-organisation view. Columns ronde/participant/standpunt/deadline/status. Schema ref by slug (zienswijze).",
				"quickFilterMode": "dropdown",
				"quickFilterMultiple": true,
				"quickFilters": [
					{ "label": "All", "filter": {}, "default": true },
					{ "label": "Open", "filter": { "status": [ "uitstaand", "in-voorbereiding" ] } },
					{ "label": "Uitstaand", "filter": { "status": "outstanding" } },
					{ "label": "In voorbereiding", "filter": { "status": "in-preparation" } },
					{ "label": "Ingediend", "filter": { "status": "submitted" } },
					{ "label": "Verwerkt", "filter": { "status": "processed" } },
					{ "label": "Niet ingediend", "filter": { "status": "not-submitted" } }
				],
				"columns": [
					{ "key": "ronde", "label": "Ronde", "widget": "link" },
					{ "key": "participant", "label": "Participant" },
					{ "key": "standpunt", "label": "Standpunt", "widget": "badge" },
					{ "key": "deadline", "label": "Deadline", "widget": "date" },
					{ "key": "status", "label": "Status", "widget": "badge" }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "ZienswijzerondeDetail", "primary": true }
				],
				"showMassExport": true,
				"sidebar": { "enabled": true, "showMetadata": true },
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		}
	]
}
