{
	"$schema": "https://codeberg.org/Conduction/nextcloud-vue/raw/branch/main/src/schemas/app-manifest-v2.schema.json",
	"_note": "Vragenuur (mondelinge vragen) + Interpellaties — appended onto the bundled src/manifest.json by main.js::mergeManifestFragments (ADR-037). Index + detail pages for both registers; schema refs BY SLUG (mondelinge-vraag / interpellatieverzoek), never PascalCase (REQ-VRI-008/REQ-VRI-014). VragenuurConfiguratie (slug vragenuur-configuratie) is per-body settings with no dedicated menu/page here — it is edited from the governance-body context; this fragment ships the 4 pipeline pages only. Submission/admission/scheduling/answer/support actions run in dedicated dialogs (modal-isolation gate) wired to the OralQuestionService endpoints; no decidesk CRUD controllers for listing/reading (redundant-controller gate).",
	"_spec": "openspec/changes/vragenuur-interpellatie/specs/mondelinge-vragen-register/spec.md",
	"menu": [
		{
			"id": "MondelingeVragen",
			"label": "Oral questions",
			"icon": "CommentOutline",
			"route": "MondelingeVragen",
			"order": 49
		},
		{
			"id": "Interpellaties",
			"label": "Interpellations",
			"icon": "CommentOutline",
			"route": "Interpellaties",
			"order": 56
		}
	],
	"pages": [
		{
			"id": "MondelingeVragen",
			"route": "/mondelinge-vragen",
			"type": "index",
			"title": "Oral questions",
			"_note": "spec: openspec/changes/vragenuur-interpellatie/specs/mondelinge-vragen-register/spec.md#requirement-req-vri-008-list-and-detail-pages-for-oral-questions",
			"config": {
				"register": "decidesk",
				"schema": "mondelinge-vraag",
				"sortKey": "@self.created",
				"sortOrder": "desc",
				"_note": "Mondelinge vragen index (REQ-VRI-008). Columns vraagNummer/onderwerp/indiener/fractie/portefeuillehouder/targetMeeting/lifecycle; quick filters on lifecycle (and fractie/portefeuillehouder via the standard facet chrome); index _search matches vraagNummer and onderwerp. CSV export via the shared ExportService + CnMassExportDialog. Sorted by vraagNummer so duplicate numbers are immediately visible.",
				"search": true,
				"searchFields": [
					"questionNumber",
					"subject"
				],
				"quickFilterMode": "dropdown",
				"quickFilterMultiple": true,
				"quickFilters": [
					{ "label": "All", "filter": {}, "default": true },
					{ "label": "Submitted", "filter": { "lifecycle": "submitted" } },
					{ "label": "Admitted", "filter": { "lifecycle": "admitted" } },
					{ "label": "Scheduled", "filter": { "lifecycle": "scheduled" } },
					{ "label": "Answered", "filter": { "lifecycle": "answered" } },
					{ "label": "Not treated", "filter": { "lifecycle": "not-handled" } },
					{ "label": "Rejected", "filter": { "lifecycle": "rejected" } },
					{ "label": "Withdrawn", "filter": { "lifecycle": "withdrawn" } }
				],
				"columns": [
					{ "key": "questionNumber", "label": "Number", "widget": "link" },
					{ "key": "subject", "label": "Subject" },
					{ "key": "submitter", "label": "Submitter" },
					{ "key": "politicalGroup", "label": "Fraction" },
					{ "key": "portefeuillehouder", "label": "Portefeuillehouder" },
					{ "key": "targetMeeting", "label": "Meeting" },
					{ "key": "lifecycle", "label": "Status", "widget": "badge" }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "MondelingeVraagDetail", "primary": true }
				],
				"showMassExport": true,
				"sidebar": { "enabled": true, "showMetadata": true },
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "MondelingeVraagDetail",
			"route": "/mondelinge-vragen/:id",
			"type": "detail",
			"title": "Oral question",
			"_note": "spec: openspec/changes/vragenuur-interpellatie/specs/mondelinge-vragen-register/spec.md#requirement-req-vri-008-list-and-detail-pages-for-oral-questions",
			"config": {
				"register": "decidesk",
				"schema": "mondelinge-vraag",
				"_note": "MondelingeVraagDetail (REQ-VRI-008). Question data leads 8-wide, admission/scheduling/answer actions stacked right; the linked indiener/fractie/portefeuillehouder/governanceBody/targetMeeting/vragenuurAgendaItem/beantwoordDoor/vervolgToezegging/bronSchriftelijkeVraag/vervolgSchriftelijkeVraag render as resolved references in the data + Related widgets (navigable links, REQ-VRI-006/REQ-VRI-005 link back to the written question and the toezegging). Files leaf for the original schriftelijke-vraag PDF. Audit trail is a sidebar tab. Submission/admission/scheduling/answer run in dedicated dialogs (modal-isolation gate) wired to OralQuestionService.",
				"widgets": [
					{ "id": "mv-data", "type": "data", "title": "Oral question", "icon": "MessageTextOutline", "content": { "columns": 2 } },
					{ "id": "mv-files", "type": "integration", "integrationId": "files", "title": "Documents", "icon": "FolderOutline" },
					{ "id": "mv-related", "type": "related", "title": "Related", "icon": "LinkVariant" }
				],
				"layout": [
					{ "id": "1", "widgetId": "mv-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 6 },
					{ "id": "2", "widgetId": "mv-files", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 6 },
					{ "id": "3", "widgetId": "mv-related", "gridX": 0, "gridY": 6, "gridWidth": 12, "gridHeight": 3 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				},
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "Interpellaties",
			"route": "/interpellaties",
			"type": "index",
			"title": "Interpellations",
			"_note": "spec: openspec/changes/vragenuur-interpellatie/specs/interpellatie-register/spec.md#requirement-req-vri-014-notifications-and-list-detail-pages-for-interpellations",
			"config": {
				"register": "decidesk",
				"schema": "interpellatieverzoek",
				"sortKey": "@self.created",
				"sortOrder": "desc",
				"_note": "Interpellaties index (REQ-VRI-014). Columns verzoekNummer/onderwerp/verzoeker/fractie/portefeuillehouder/lifecycle; the support status against the body threshold is a client-side computed display on the detail page (REQ-VRI-011), not a stored column. Quick filters on lifecycle (and fractie via facet chrome); index _search matches verzoekNummer and onderwerp. CSV export via ExportService + CnMassExportDialog. Sorted by verzoekNummer.",
				"search": true,
				"searchFields": [
					"requestNumber",
					"subject"
				],
				"quickFilterMode": "dropdown",
				"quickFilterMultiple": true,
				"quickFilters": [
					{ "label": "All", "filter": {}, "default": true },
					{ "label": "Submitted", "filter": { "lifecycle": "submitted" } },
					{ "label": "Admitted", "filter": { "lifecycle": "admitted" } },
					{ "label": "Scheduled", "filter": { "lifecycle": "agendised" } },
					{ "label": "Treated", "filter": { "lifecycle": "handled" } },
					{ "label": "Rejected", "filter": { "lifecycle": "rejected" } },
					{ "label": "Withdrawn", "filter": { "lifecycle": "withdrawn" } }
				],
				"columns": [
					{ "key": "requestNumber", "label": "Number", "widget": "link" },
					{ "key": "subject", "label": "Subject" },
					{ "key": "requester", "label": "Requester" },
					{ "key": "politicalGroup", "label": "Fraction" },
					{ "key": "portefeuillehouder", "label": "Portefeuillehouder" },
					{ "key": "lifecycle", "label": "Status", "widget": "badge" }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "InterpellatieverzoekDetail", "primary": true }
				],
				"showMassExport": true,
				"sidebar": { "enabled": true, "showMetadata": true },
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "InterpellatieverzoekDetail",
			"route": "/interpellaties/:id",
			"type": "detail",
			"title": "Interpellation request",
			"_note": "spec: openspec/changes/vragenuur-interpellatie/specs/interpellatie-register/spec.md#requirement-req-vri-014-notifications-and-list-detail-pages-for-interpellations",
			"config": {
				"register": "decidesk",
				"schema": "interpellatieverzoek",
				"_note": "InterpellatieverzoekDetail (REQ-VRI-011/REQ-VRI-012/REQ-VRI-013/REQ-VRI-014). Request data leads 8-wide, admission/scheduling/treatment actions stacked right; the linked verzoeker/fractie/portefeuillehouder/governanceBody/behandeldIn/agendaItem render as resolved references in the data + Related widgets (navigable links). Support recording (steunbetuigingen) runs in a dedicated dialog while ingediend; the support status ('N of M required', ceil) is computed client-side from VragenuurConfiguratie and the body's member count and informs, never gates. Files leaf for the written interpellation request PDF. Audit trail is a sidebar tab. Actions wired to OralQuestionService (modal-isolation gate).",
				"widgets": [
					{ "id": "int-data", "type": "data", "title": "Interpellation request", "icon": "MessageTextOutline", "content": { "columns": 2 } },
					{ "id": "int-files", "type": "integration", "integrationId": "files", "title": "Documents", "icon": "FolderOutline" },
					{ "id": "int-related", "type": "related", "title": "Related", "icon": "LinkVariant" }
				],
				"layout": [
					{ "id": "1", "widgetId": "int-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 6 },
					{ "id": "2", "widgetId": "int-files", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 6 },
					{ "id": "3", "widgetId": "int-related", "gridX": 0, "gridY": 6, "gridWidth": 12, "gridHeight": 3 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				},
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		}
	]
}
