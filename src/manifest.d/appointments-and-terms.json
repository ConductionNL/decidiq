{
	"$schema": "https://codeberg.org/Conduction/nextcloud-vue/raw/branch/main/src/schemas/app-manifest-v2.schema.json",
	"_note": "Voordrachten (nominations) + Rooster van aftreden (retirement schedule) + Termijnregelingen (term rules) — appended onto the bundled src/manifest.json by main.js::mergeManifestFragments (ADR-037). Index + detail pages for voordracht, rooster-van-aftreden, and termijn-regeling, plus a rooster-regel index (the ordered per-body term view the dashboard expiring-terms KPI deep-links to). Schema refs BY SLUG (voordracht / termijn-regeling / rooster-van-aftreden / rooster-regel), never PascalCase. The Dashboard 'termijnen die binnen N maanden aflopen' KPI stat widget (REQ-APT-012) lives in the base src/manifest.json (design D6/mergePages replaces a same-id page wholesale, so a fragment cannot add one widget to Dashboard without duplicating it) — out of scope for this declarative-core fragment.",
	"_spec": "openspec/changes/appointments-and-terms/specs/appointments-and-terms/spec.md",
	"menu": [
		{
			"id": "Voordrachten",
			"label": "Nominations",
			"icon": "Account",
			"route": "Voordrachten",
			"order": 55
		},
		{
			"id": "Roosters",
			"label": "Retirement schedules",
			"icon": "Calendar",
			"route": "Roosters",
			"order": 60
		},
		{
			"id": "Termijnregelingen",
			"label": "Term rules",
			"icon": "Cog",
			"route": "Termijnregelingen",
			"order": 65
		}
	],
	"pages": [
		{
			"id": "Voordrachten",
			"route": "/voordrachten",
			"type": "index",
			"title": "Nominations",
			"_note": "spec: openspec/changes/appointments-and-terms/specs/appointments-and-terms/spec.md (REQ-APT-012). Voordrachtenlijst. Columns motivering (link) / body / targetRole / voordragendePartij / lifecycle / besluit; quick filters on lifecycle (body + voordragende partij available via the sidebar facets). CSV export via the shared ExportService + CnMassExportDialog.",
			"config": {
				"register": "decidesk",
				"schema": "voordracht",
				"sortKey": "@self.created",
				"sortOrder": "desc",
				"_note": "kandidaten is a structured array (design D1) so the primary link column uses motivering; candidates render in the detail data widget.",
				"quickFilterMode": "dropdown",
				"quickFilterMultiple": true,
				"quickFilters": [
					{ "label": "All", "filter": {}, "default": true },
					{ "label": "Submitted", "filter": { "lifecycle": "ingediend" } },
					{ "label": "In treatment", "filter": { "lifecycle": "behandeld" } },
					{ "label": "Appointed", "filter": { "lifecycle": "benoemd" } },
					{ "label": "Not appointed", "filter": { "lifecycle": "niet-benoemd" } },
					{ "label": "Withdrawn", "filter": { "lifecycle": "ingetrokken" } }
				],
				"columns": [
					{ "key": "motivering", "label": "Nomination", "widget": "link" },
					{ "key": "body", "label": "Governance body" },
					{ "key": "targetRole", "label": "Target role", "widget": "badge" },
					{ "key": "voordragendePartij", "label": "Nominating party" },
					{ "key": "lifecycle", "label": "Status", "widget": "badge" },
					{ "key": "besluit", "label": "Decision" }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "VoordrachtDetail", "primary": true }
				],
				"showMassExport": true,
				"sidebar": { "enabled": true, "showMetadata": true },
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "VoordrachtDetail",
			"route": "/voordrachten/:id",
			"type": "detail",
			"title": "Nomination",
			"_note": "spec: openspec/changes/appointments-and-terms/specs/appointments-and-terms/spec.md (REQ-APT-012). Candidates + motivering lead 8-wide; the linked body / post / agendapunt / votingRound / besluit / membership render as resolved references in the data + Related widgets. Files leaf for supporting documents. Audit trail is a sidebar tab.",
			"config": {
				"register": "decidesk",
				"schema": "voordracht",
				"widgets": [
					{ "id": "voordracht-data", "type": "data", "title": "Nomination", "icon": "AccountGroup", "content": { "columns": 2 } },
					{ "id": "voordracht-files", "type": "integration", "integrationId": "files", "title": "Documents", "icon": "FolderOutline" },
					{ "id": "voordracht-related", "type": "related", "title": "Related", "icon": "LinkVariant" }
				],
				"layout": [
					{ "id": "1", "widgetId": "voordracht-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 6 },
					{ "id": "2", "widgetId": "voordracht-files", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 6 },
					{ "id": "3", "widgetId": "voordracht-related", "gridX": 0, "gridY": 6, "gridWidth": 12, "gridHeight": 3 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				},
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "Roosters",
			"route": "/roosters",
			"type": "index",
			"title": "Retirement schedules",
			"_note": "spec: openspec/changes/appointments-and-terms/specs/appointments-and-terms/spec.md (REQ-APT-007/009/012). One rooster van aftreden per governance body. Columns body (link) / gegenereerdOp / publicatiedatum; regenerate, CSV export, and publication actions live on the detail page (imperative RoosterService endpoints, out of scope for this declarative core).",
			"config": {
				"register": "decidesk",
				"schema": "rooster-van-aftreden",
				"sortKey": "@self.created",
				"sortOrder": "desc",
				"quickFilterMode": "dropdown",
				"quickFilterMultiple": false,
				"quickFilters": [
					{ "label": "All", "filter": {}, "default": true }
				],
				"columns": [
					{ "key": "body", "label": "Governance body", "widget": "link" },
					{ "key": "gegenereerdOp", "label": "Generated at" },
					{ "key": "publicatiedatum", "label": "Published" }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "RoosterDetail", "primary": true }
				],
				"showMassExport": true,
				"sidebar": { "enabled": true, "showMetadata": true },
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "RoosterDetail",
			"route": "/roosters/:id",
			"type": "detail",
			"title": "Retirement schedule",
			"_note": "spec: openspec/changes/appointments-and-terms/specs/appointments-and-terms/spec.md (REQ-APT-007). Rooster metadata (body / gegenereerdOp / publication) leads 8-wide; the ordered RoosterRegel term entries render in the Related widget with their derived term data. gegenereerdOp is shown prominently so a stale rooster is visibly stale. Audit trail is a sidebar tab.",
			"config": {
				"register": "decidesk",
				"schema": "rooster-van-aftreden",
				"widgets": [
					{ "id": "rooster-data", "type": "data", "title": "Retirement schedule", "icon": "Calendar", "content": { "columns": 2 } },
					{ "id": "rooster-related", "type": "related", "title": "Term entries", "icon": "LinkVariant" }
				],
				"layout": [
					{ "id": "1", "widgetId": "rooster-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 4 },
					{ "id": "2", "widgetId": "rooster-related", "gridX": 0, "gridY": 4, "gridWidth": 12, "gridHeight": 6 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				},
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "Roosterregels",
			"route": "/roosterregels",
			"type": "index",
			"title": "Term entries",
			"_note": "spec: openspec/changes/appointments-and-terms/specs/appointments-and-terms/spec.md (REQ-APT-008/010/012). The ordered per-regel view the Dashboard expiring-terms KPI deep-links to. Columns persoonNaam (link) / role / termijnNummer / eindeTermijnDatum / herbenoembaar / rappelStatus; quick filters on herbenoembaar. CSV export (UTF-8 BOM, end-of-term order) via ExportService + CnMassExportDialog. Term warnings (termijnNummer > max) are conveyed in text, not colour alone (WCAG 2.1 AA).",
			"config": {
				"register": "decidesk",
				"schema": "rooster-regel",
				"sortKey": "@self.created",
				"sortOrder": "desc",
				"quickFilterMode": "dropdown",
				"quickFilterMultiple": true,
				"quickFilters": [
					{ "label": "All", "filter": {}, "default": true },
					{ "label": "Reappointable", "filter": { "herbenoembaar": true } },
					{ "label": "At max term", "filter": { "herbenoembaar": false } }
				],
				"columns": [
					{ "key": "persoonNaam", "label": "Member", "widget": "link" },
					{ "key": "role", "label": "Role", "widget": "badge" },
					{ "key": "termijnNummer", "label": "Term no." },
					{ "key": "eindeTermijnDatum", "label": "End of term" },
					{ "key": "herbenoembaar", "label": "Reappointable", "widget": "badge" },
					{ "key": "rappelStatus", "label": "Reminder", "widget": "badge" }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "RoosterregelDetail", "primary": true }
				],
				"showMassExport": true,
				"sidebar": { "enabled": true, "showMetadata": true },
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "RoosterregelDetail",
			"route": "/roosterregels/:id",
			"type": "detail",
			"title": "Term entry",
			"_note": "spec: openspec/changes/appointments-and-terms/specs/appointments-and-terms/spec.md (REQ-APT-006/010). Derived term data leads 8-wide; the linked rooster and source membership render as resolved references in the Related widget. Audit trail is a sidebar tab.",
			"config": {
				"register": "decidesk",
				"schema": "rooster-regel",
				"widgets": [
					{ "id": "regel-data", "type": "data", "title": "Term entry", "icon": "Calendar", "content": { "columns": 2 } },
					{ "id": "regel-related", "type": "related", "title": "Related", "icon": "LinkVariant" }
				],
				"layout": [
					{ "id": "1", "widgetId": "regel-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 6 },
					{ "id": "2", "widgetId": "regel-related", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 6 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				},
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "Termijnregelingen",
			"route": "/termijnregelingen",
			"type": "index",
			"title": "Term rules",
			"_note": "spec: openspec/changes/appointments-and-terms/specs/appointments-and-terms/spec.md (REQ-APT-005/012). Termijnregeling configuration surface. Columns body (link) / role / termijnDuurMaanden / maxAansluitendeTermijnen; quick filters on role.",
			"config": {
				"register": "decidesk",
				"schema": "termijn-regeling",
				"sortKey": "@self.created",
				"sortOrder": "desc",
				"quickFilterMode": "dropdown",
				"quickFilterMultiple": true,
				"quickFilters": [
					{ "label": "All", "filter": {}, "default": true },
					{ "label": "Body-wide", "filter": { "role": "" } },
					{ "label": "Chair", "filter": { "role": "chair" } },
					{ "label": "Member", "filter": { "role": "member" } }
				],
				"columns": [
					{ "key": "body", "label": "Governance body", "widget": "link" },
					{ "key": "role", "label": "Role", "widget": "badge" },
					{ "key": "termijnDuurMaanden", "label": "Term (months)" },
					{ "key": "maxAansluitendeTermijnen", "label": "Max consecutive terms" }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "TermijnRegelingDetail", "primary": true }
				],
				"showMassExport": true,
				"sidebar": { "enabled": true, "showMetadata": true },
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		},
		{
			"id": "TermijnRegelingDetail",
			"route": "/termijnregelingen/:id",
			"type": "detail",
			"title": "Term rule",
			"_note": "spec: openspec/changes/appointments-and-terms/specs/appointments-and-terms/spec.md (REQ-APT-005). Term rule data leads 8-wide; the linked body renders as a resolved reference in the Related widget. Audit trail is a sidebar tab.",
			"config": {
				"register": "decidesk",
				"schema": "termijn-regeling",
				"widgets": [
					{ "id": "regeling-data", "type": "data", "title": "Term rule", "icon": "Calendar", "content": { "columns": 2 } },
					{ "id": "regeling-related", "type": "related", "title": "Related", "icon": "LinkVariant" }
				],
				"layout": [
					{ "id": "1", "widgetId": "regeling-data", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 6 },
					{ "id": "2", "widgetId": "regeling-related", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 6 }
				],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				},
				"documentationUrl": "https://decidesk.conduction.nl"
			}
		}
	]
}
