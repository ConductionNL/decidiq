{
	"$schema": "https://codeberg.org/Conduction/nextcloud-vue/raw/branch/main/src/schemas/app-manifest-v2.schema.json",
	"version": "2.0.0",
	"dependencies": ["openregister"],
	"menu": [
		{ "id": "Dashboard", "label": "Dashboard", "icon": "icon-category-dashboard", "route": "Dashboard", "order": 10 },
		{ "id": "Minutes", "label": "Minutes", "icon": "icon-file", "route": "Minutes", "order": 20 },
		{ "id": "Decisions", "label": "Decisions", "icon": "icon-checkmark", "route": "Decisions", "order": 30 },
		{ "id": "ActionItems", "label": "Action items", "icon": "icon-checkmark", "route": "ActionItems", "order": 40 },
		{ "id": "Motions", "label": "Motions", "icon": "icon-comment", "route": "Motions", "order": 50 },
		{ "id": "Meetings", "label": "Meetings", "icon": "icon-group", "route": "Meetings", "order": 60 },
		{ "id": "Workspaces", "label": "Workspaces", "icon": "icon-group", "route": "Workspaces", "order": 70 },
		{ "id": "Engagement", "label": "Engagement", "icon": "icon-quota", "route": "Engagement", "order": 85 },
		{ "id": "Documentation", "label": "Documentation", "icon": "icon-info", "href": "https://decidesk.conduction.nl", "section": "footer", "order": 90 },
		{ "id": "SettingsMenu", "label": "Settings", "icon": "icon-settings", "route": "Settings", "section": "settings", "order": 99 },
		{ "id": "FeaturesRoadmapMenu", "label": "Features & roadmap", "icon": "icon-toggle", "route": "FeaturesRoadmap", "section": "footer", "order": 100 }
	],
	"pages": [
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"config": {
				"widgets": [
					{
						"id": "minutes-in-review",
						"type": "stats-block",
						"title": "Notulen ter goedkeuring",
						"iconClass": "icon-file",
						"props": {
							"countLabel": "notulen",
							"variant": "warning"
						},
						"dataSource": {
							"register": "decidesk",
							"schema": "minutes",
							"filter": { "lifecycle": "review" },
							"aggregate": "count"
						}
					},
					{
						"id": "published-decisions",
						"type": "stats-block",
						"title": "Gepubliceerde besluiten",
						"iconClass": "icon-checkmark",
						"props": {
							"countLabel": "besluiten",
							"variant": "success"
						},
						"dataSource": {
							"register": "decidesk",
							"schema": "decision",
							"filter": { "isPublished": "public" },
							"aggregate": "count"
						}
					},
					{
						"id": "open-action-items",
						"type": "stats-block",
						"title": "Open actiepunten",
						"iconClass": "icon-checkmark",
						"props": {
							"countLabel": "actiepunten",
							"variant": "primary"
						},
						"dataSource": {
							"register": "decidesk",
							"schema": "action-item",
							"filter": { "taskStatus": ["open", "in-progress"] },
							"aggregate": "count"
						}
					}
				],
				"layout": [
					{ "id": "minutes-in-review",   "widgetId": "minutes-in-review",   "gridX": 0, "gridY": 0, "gridWidth": 4, "gridHeight": 2, "showTitle": true },
					{ "id": "published-decisions", "widgetId": "published-decisions", "gridX": 4, "gridY": 0, "gridWidth": 4, "gridHeight": 2, "showTitle": true },
					{ "id": "open-action-items",   "widgetId": "open-action-items",   "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 2, "showTitle": true }
				]
			}
		},
		{
			"id": "GovernanceBodies",
			"route": "/governance-bodies",
			"type": "index",
			"title": "Governance bodies",
			"config": {
				"register": "decidesk",
				"schema": "governance-body",
				"columns": ["name", "bodyType", "domain", "termEnd"],
				"sidebar": { "enabled": true, "showMetadata": true }
			}
		},
		{
			"id": "GovernanceBodyDetail",
			"route": "/governance-bodies/:id",
			"type": "detail",
			"title": "Governance body",
			"config": {
				"register": "decidesk",
				"schema": "governance-body",
				"sidebarTabs": [
					{ "id": "overview", "label": "Overview", "icon": "icon-info",         "widgets": [{ "type": "data" }, { "type": "metadata" }], "order": 10 },
					{ "id": "members",  "label": "Members",  "icon": "icon-group",        "component": "GovernanceBodyMembersTab",                  "order": 20 },
					{ "id": "audit",    "label": "Audit trail", "icon": "icon-history",   "widgets": [{ "type": "audit-trail" }],                   "order": 90 }
				],
				"sidebar": {
					"enabled": true,
					"register": "decidesk",
					"schema": "governance-body",
					"useRegistry": true
				}
			}
		},
		{
			"id": "Meetings",
			"route": "/meetings",
			"type": "index",
			"title": "Meetings",
			"config": {
				"register": "decidesk",
				"schema": "meeting",
				"columns": ["title", "meetingType", "scheduledDate", { "key": "meetingMode", "label": "Mode", "widget": "badge" }, "lifecycle"],
				"sidebar": { "enabled": true, "showMetadata": true }
			}
		},
		{
			"id": "MeetingDetail",
			"route": "/meetings/:id",
			"type": "detail",
			"title": "Meeting",
			"config": {
				"register": "decidesk",
				"schema": "meeting",
				"sidebarTabs": [
					{ "id": "overview",     "label": "Overview",     "icon": "icon-info",     "widgets": [{ "type": "data" }, { "type": "metadata" }], "order": 10 },
					{ "id": "agenda",       "label": "Agenda",       "icon": "icon-files",    "component": "MeetingAgendaTab",                          "order": 20 },
					{ "id": "participants", "label": "Participants", "icon": "icon-group",    "component": "MeetingParticipantsTab",                    "order": 30 },
					{ "id": "minutes",      "label": "Minutes",      "icon": "icon-file",     "component": "MeetingMinutesTab",                         "order": 40 },
					{ "id": "decisions",    "label": "Decisions",    "icon": "icon-checkmark", "component": "MeetingDecisionsTab",                      "order": 50 },
					{ "id": "votes",        "label": "Votes",        "icon": "icon-checkmark", "component": "MeetingVotesTab",                          "order": 60 },
					{ "id": "audit",        "label": "Audit trail",  "icon": "icon-history",  "widgets": [{ "type": "audit-trail" }],                   "order": 90 }
				]
			}
		},
		{
			"id": "MeetingIntegrations",
			"route": "/meetings/:id/integrations",
			"type": "detail",
			"title": "Meeting integrations",
			"config": {
				"register": "decidesk",
				"schema": "meeting",
				"description": "External integrations linked to this meeting — open the sidebar for the Action items board (Deck), Discussion (Talk), linked articles, files, notes, tags and the audit trail.",
				"sidebar": {
					"enabled": true,
					"register": "decidesk",
					"schema": "meeting",
					"useRegistry": true
				}
			},
			"_note": "The Action items board is consumed from the ADR-019 Deck integration leaf bound to the meeting object (migrate-action-items-to-deck-leaf), projecting the CalDAV VTODO ActionItems (ADR-002 source of truth) as cards and replacing the retired in-app TaskService/DelegationService board. Discussion is consumed from the Talk leaf. The registry hides each tab gracefully when its backing app is absent — action items then remain reachable via the Nextcloud Tasks app over the same VTODOs."
		},
		{
			"id": "DecisionIntegrations",
			"route": "/decisions/:id/integrations",
			"type": "detail",
			"title": "Decision integrations",
			"component": "DecisionIntegrations",
			"config": {
				"register": "decidesk",
				"schema": "decision",
				"description": "External integrations linked to this decision dossier — open the sidebar for the Action items board (Deck), to link emails, browse files, notes, tags and the audit trail.",
				"sidebar": {
					"enabled": true,
					"register": "decidesk",
					"schema": "decision",
					"useRegistry": true
				}
			},
			"_note": "Email linking is consumed from the ADR-019 Email integration leaf bound to the decision object (migrate-email-links-to-email-leaf), replacing the retired in-app EmailLink store. The Action items board is consumed from the ADR-019 Deck integration leaf bound to the decision object (migrate-action-items-to-deck-leaf), projecting CalDAV VTODO ActionItems (ADR-002) as cards and replacing the retired in-app TaskService/DelegationService board. The registry hides each tab gracefully when its backing app is absent — action items then remain reachable via the Nextcloud Tasks app over the same VTODOs."
		},
		{
			"id": "AgendaItemIntegrations",
			"route": "/agenda-items/:id/integrations",
			"type": "detail",
			"title": "Agenda item integrations",
			"component": "AgendaItemIntegrations",
			"config": {
				"register": "decidesk",
				"schema": "agenda-item",
				"description": "External integrations linked to this agenda item — open the sidebar to link emails, browse files, notes, tags, tasks and the audit trail.",
				"sidebar": {
					"enabled": true,
					"register": "decidesk",
					"schema": "agenda-item",
					"useRegistry": true
				}
			},
			"_note": "Email linking is consumed from the ADR-019 Email integration leaf bound to the agenda-item object (migrate-email-links-to-email-leaf), replacing the retired in-app EmailLink store. Registry hides the Email tab gracefully when Mail is absent."
		},
		{
			"id": "LiveMeeting",
			"route": "/meetings/:id/live",
			"type": "custom",
			"title": "Live meeting",
			"component": "LiveMeetingView",
			"_note": "Realtime meeting shell — WebSocket subscriptions, frame-by-frame UI, per-vote-card animations. No typed primitive analogue; documented as the canonical example for a future type:realtime lib extension. See src/views/LiveMeeting.vue."
		},
		{
			"id": "Participants",
			"route": "/participants",
			"type": "index",
			"title": "Participants",
			"config": {
				"register": "decidesk",
				"schema": "participant",
				"columns": ["displayName", "role", "party", "email"],
				"sidebar": { "enabled": true, "showMetadata": true }
			}
		},
		{
			"id": "ParticipantDetail",
			"route": "/participants/:id",
			"type": "detail",
			"title": "Participant",
			"config": {
				"register": "decidesk",
				"schema": "participant",
				"sidebarTabs": [
					{ "id": "overview", "label": "Overview",    "icon": "icon-info",    "widgets": [{ "type": "data" }, { "type": "metadata" }], "order": 10 },
					{ "id": "audit",    "label": "Audit trail", "icon": "icon-history", "widgets": [{ "type": "audit-trail" }],                   "order": 90 }
				],
				"sidebar": {
					"enabled": true,
					"register": "decidesk",
					"schema": "participant",
					"useRegistry": true
				}
			}
		},
		{
			"id": "AgendaItems",
			"route": "/agenda-items",
			"type": "index",
			"title": "Agenda items",
			"config": {
				"register": "decidesk",
				"schema": "agenda-item",
				"columns": ["orderNumber", "title", "itemType", "estimatedDuration", "isRecurring"],
				"actions": [
					{ "id": "view", "label": "View", "icon": "icon-toggle", "handler": "navigate", "route": "AgendaItemDetail", "primary": true },
					{ "id": "integrations", "label": "Integrations", "icon": "icon-mail", "handler": "navigate", "route": "AgendaItemIntegrations" }
				],
				"sidebar": { "enabled": true, "showMetadata": true }
			}
		},
		{
			"id": "AgendaItemDetail",
			"route": "/agenda-items/:id",
			"type": "detail",
			"title": "Agenda item",
			"config": {
				"register": "decidesk",
				"schema": "agenda-item",
				"sidebarTabs": [
					{ "id": "overview", "label": "Overview",    "icon": "icon-info",    "widgets": [{ "type": "data" }, { "type": "metadata" }], "order": 10 },
					{ "id": "motions",  "label": "Motions",     "icon": "icon-comment", "component": "AgendaMotionsTab",                          "order": 20 },
					{ "id": "audit",    "label": "Audit trail", "icon": "icon-history", "widgets": [{ "type": "audit-trail" }],                   "order": 90 }
				]
			}
		},
		{
			"id": "Motions",
			"route": "/motions",
			"type": "index",
			"title": "Motions",
			"config": {
				"register": "decidesk",
				"schema": "motion",
				"columns": ["title", "motionType", "proposer", "lifecycle", "submittedAt"],
				"actions": [
					{ "id": "view", "label": "View", "icon": "icon-toggle", "handler": "navigate", "route": "MotionDetail", "primary": true },
					{ "id": "integrations", "label": "Discussion", "icon": "icon-comment", "handler": "navigate", "route": "MotionIntegrations" }
				],
				"sidebar": { "enabled": true, "showMetadata": true }
			}
		},
		{
			"id": "MotionDetail",
			"route": "/motions/:id",
			"type": "detail",
			"title": "Motion",
			"config": {
				"register": "decidesk",
				"schema": "motion",
				"sidebarTabs": [
					{ "id": "overview",   "label": "Overview",     "icon": "icon-info",       "widgets": [{ "type": "data" }, { "type": "metadata" }], "order": 10 },
					{ "id": "amendments", "label": "Amendments",   "icon": "icon-files",      "component": "MotionAmendmentsTab",                       "order": 20 },
					{ "id": "votes",      "label": "Votes",        "icon": "icon-checkmark",  "component": "MotionVotesTab",                            "order": 30 },
					{ "id": "votingRound", "label": "Voting round", "icon": "icon-checkmark", "component": "MotionVotingRoundTab",                      "order": 40 },
					{ "id": "audit",      "label": "Audit trail",  "icon": "icon-history",    "widgets": [{ "type": "audit-trail" }],                   "order": 90 }
				]
			}
		},
		{
			"id": "MotionIntegrations",
			"route": "/motions/:id/integrations",
			"type": "custom",
			"title": "Motion integrations",
			"component": "MotionIntegrations",
			"config": {
				"register": "decidesk",
				"schema": "motion",
				"description": "External integrations linked to this motion — open the sidebar for Discussion (Talk), files, notes, tags, tasks and the audit trail.",
				"sidebar": {
					"enabled": true,
					"register": "decidesk",
					"schema": "motion",
					"useRegistry": true
				}
			},
			"_note": "Discussion is consumed from the ADR-019 Talk integration leaf bound to the motion object (migrate-comments-to-talk-leaf), replacing the retired in-app CommentService. Registry hides the Talk tab gracefully when Talk is absent."
		},
		{
			"id": "AmendmentDetail",
			"route": "/amendments/:id",
			"type": "detail",
			"title": "Amendment",
			"config": {
				"register": "decidesk",
				"schema": "amendment",
				"sidebarTabs": [
					{ "id": "overview",     "label": "Overview",     "icon": "icon-info",    "widgets": [{ "type": "data" }, { "type": "metadata" }], "order": 10 },
					{ "id": "parentMotion", "label": "Parent motion","icon": "icon-comment", "component": "AmendmentParentMotionTab",                  "order": 20 },
					{ "id": "audit",        "label": "Audit trail",  "icon": "icon-history", "widgets": [{ "type": "audit-trail" }],                   "order": 90 }
				]
			}
		},
		{
			"id": "Minutes",
			"route": "/minutes",
			"type": "index",
			"title": "Minutes",
			"config": {
				"register": "decidesk",
				"schema": "minutes",
				"columns": ["title", "lifecycle", "version", "approvedAt"],
				"sidebar": { "enabled": true, "showMetadata": true }
			}
		},
		{
			"id": "MinutesDetail",
			"route": "/minutes/:id",
			"type": "detail",
			"title": "Minutes detail",
			"config": {
				"register": "decidesk",
				"schema": "minutes",
				"sidebarTabs": [
					{ "id": "overview", "label": "Overview",    "icon": "icon-info",    "widgets": [{ "type": "data" }, { "type": "metadata" }], "order": 10 },
					{ "id": "signers",  "label": "Signers",     "icon": "icon-user",    "component": "MinutesSignersTab",                         "order": 20 },
					{ "id": "approval",  "label": "Approval",  "icon": "icon-checkmark", "component": "MinutesApprovalTab",                       "order": 30 },
					{ "id": "documents", "label": "Documents", "icon": "icon-file",      "component": "MinutesDocumentTab",                       "order": 40 },
					{ "id": "audit",    "label": "Audit trail", "icon": "icon-history", "widgets": [{ "type": "audit-trail" }],                   "order": 90 }
				]
			}
		},
		{
			"id": "Decisions",
			"route": "/decisions",
			"type": "index",
			"title": "Decisions",
			"config": {
				"register": "decidesk",
				"schema": "decision",
				"columns": [
					{ "key": "title", "label": "Title", "widget": "link" },
					{ "key": "lifecycle", "label": "Lifecycle", "widget": "badge" },
					{ "key": "outcome", "label": "Outcome", "widget": "badge" },
					{ "key": "decisionDate", "label": "Decision date", "formatter": "date" },
					{ "key": "isPublished", "label": "Publication", "widget": "badge" },
					{ "key": "legalBasis", "label": "Legal basis", "hidden": true }
				],
				"actions": [
					{ "id": "view", "label": "View", "icon": "icon-toggle", "handler": "navigate", "route": "DecisionDetail", "primary": true },
					{ "id": "integrations", "label": "Integrations", "icon": "icon-mail", "handler": "navigate", "route": "DecisionIntegrations" },
					{ "id": "publish", "label": "Publish", "icon": "icon-upload", "handler": "emit", "permission": "decidesk.decision.publish", "confirm": true }
				],
				"sidebar": { "enabled": true, "showMetadata": true }
			}
		},
		{
			"id": "DecisionDetail",
			"route": "/decisions/:id",
			"type": "detail",
			"title": "Decision",
			"config": {
				"register": "decidesk",
				"schema": "decision",
				"sidebarTabs": [
					{ "id": "overview",    "label": "Overview",    "icon": "icon-info",      "widgets": [{ "type": "data" }, { "type": "metadata" }], "order": 10 },
					{ "id": "lifecycle",   "label": "Lifecycle",   "icon": "icon-timezone",  "component": "DecisionLifecycleTab",                      "order": 15 },
					{ "id": "actionItems", "label": "Action items","icon": "icon-checkmark", "component": "DecisionActionItemsTab",                    "order": 20 },
					{ "id": "voting",      "label": "Voting results", "icon": "icon-comment", "component": "DecisionVotingTab",                        "order": 30 },
					{ "id": "audit",       "label": "Audit trail", "icon": "icon-history",   "widgets": [{ "type": "audit-trail" }],                   "order": 90 }
				]
			}
		},
		{
			"id": "ActionItems",
			"route": "/action-items",
			"type": "index",
			"title": "Action items",
			"config": {
				"register": "decidesk",
				"schema": "action-item",
				"columns": ["title", "assignee", "dueDate", { "key": "taskStatus", "label": "Status", "widget": "badge" }],
				"sidebar": { "enabled": true, "showMetadata": true }
			}
		},
		{
			"id": "ActionItemDetail",
			"route": "/action-items/:id",
			"type": "detail",
			"title": "Action item",
			"config": {
				"register": "decidesk",
				"schema": "action-item",
				"sidebarTabs": [
					{ "id": "overview", "label": "Overview",    "icon": "icon-info",    "widgets": [{ "type": "data" }, { "type": "metadata" }], "order": 10 },
					{ "id": "audit",    "label": "Audit trail", "icon": "icon-history", "widgets": [{ "type": "audit-trail" }],                   "order": 90 }
				]
			}
		},
		{
			"id": "Workspaces",
			"route": "/workspaces",
			"type": "index",
			"title": "Workspaces",
			"config": {
				"register": "decidesk",
				"schema": "collaboration-workspace",
				"columns": ["name", "type", { "key": "accessLevel", "label": "Access", "widget": "badge" }, "createdAt"],
				"sidebar": { "enabled": true, "showMetadata": true }
			}
		},
		{
			"id": "WorkspaceDetail",
			"route": "/workspaces/:id",
			"type": "detail",
			"title": "Workspace",
			"config": {
				"register": "decidesk",
				"schema": "collaboration-workspace",
				"sidebarTabs": [
					{ "id": "overview", "label": "Overview",    "icon": "icon-info",    "widgets": [{ "type": "data" }, { "type": "metadata" }], "order": 10 },
					{ "id": "audit",    "label": "Audit trail", "icon": "icon-history", "widgets": [{ "type": "audit-trail" }],                   "order": 90 }
				]
			}
		},
		{
			"id": "Engagement",
			"route": "/engagement",
			"type": "index",
			"title": "Engagement",
			"config": {
				"register": "decidesk",
				"schema": "engagement-record",
				"columns": ["meeting", "participant", "speakingDuration", "engagementScore"],
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"register": "decidesk",
					"schema": "engagement-record",
					"useRegistry": true
				}
			}
		},
		{
			"id": "Settings",
			"route": "/settings",
			"type": "settings",
			"title": "Settings",
			"config": {
				"saveEndpoint": "/index.php/apps/decidesk/api/settings",
				"sections": [
					{
						"title": "Version",
						"widgets": [
							{
								"type": "version-info",
								"props": {
									"appName": "Decidesk",
									"showUpdateButton": true,
									"isUpToDate": true,
									"title": "Version Information",
									"description": "Information about the current Decidesk installation"
								}
							}
						]
					},
					{
						"title": "Registers",
						"widgets": [
							{
								"type": "register-mapping",
								"props": {
									"name": "Register Configuration",
									"description": "Configure the OpenRegister schema mappings for all Decidesk object types.",
									"showReimportButton": true,
									"groups": [
										{
											"name": "Decidesk",
											"types": [
												{ "slug": "governance-body", "label": "Governance Bodies" },
												{ "slug": "meeting", "label": "Meetings" },
												{ "slug": "participant", "label": "Participants" },
												{ "slug": "agenda-item", "label": "Agenda Items" },
												{ "slug": "motion", "label": "Motions" },
												{ "slug": "amendment", "label": "Amendments" },
												{ "slug": "voting-round", "label": "Voting Rounds" },
