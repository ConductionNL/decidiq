		{ "registerSlug": "decidesk", "schemaSlug": "agenda-item", "urlTemplate": "/apps/decidesk/#/agenda-items/{uuid}", "displayName": "Agenda item" },
		{ "registerSlug": "decidesk", "schemaSlug": "motion", "urlTemplate": "/apps/decidesk/#/motions/{uuid}", "displayName": "Motion" },
		{ "registerSlug": "decidesk", "schemaSlug": "amendment", "urlTemplate": "/apps/decidesk/#/amendments/{uuid}", "displayName": "Amendment" },
		{ "registerSlug": "decidesk", "schemaSlug": "voting-round", "urlTemplate": "/apps/decidesk/#/voting-rounds/{uuid}", "displayName": "Voting round" },
		{ "registerSlug": "decidesk", "schemaSlug": "vote", "urlTemplate": "/apps/decidesk/#/votes/{uuid}", "displayName": "Vote" },
		{ "registerSlug": "decidesk", "schemaSlug": "decision", "urlTemplate": "/apps/decidesk/#/decisions/{uuid}", "displayName": "Decision" },
		{ "registerSlug": "decidesk", "schemaSlug": "action-item", "urlTemplate": "/apps/decidesk/#/action-items/{uuid}", "displayName": "Action item" },
		{ "registerSlug": "decidesk", "schemaSlug": "minutes", "urlTemplate": "/apps/decidesk/#/minutes/{uuid}", "displayName": "Minutes" },
		{ "registerSlug": "decidesk", "schemaSlug": "digital-document", "urlTemplate": "/apps/decidesk/#/digital-documents/{uuid}", "displayName": "Digital document" },
		{ "registerSlug": "decidesk", "schemaSlug": "monetary-amount", "urlTemplate": "/apps/decidesk/#/monetary-amounts/{uuid}", "displayName": "Monetary amount" },
		{ "registerSlug": "decidesk", "schemaSlug": "offer", "urlTemplate": "/apps/decidesk/#/offers/{uuid}", "displayName": "Offer" },
