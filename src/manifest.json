						"id": "recent-decisions",
						"type": "object-list",
						"title": "Recent decisions",
						"content": { "register": "decidesk", "schema": "decision", "filter": {}, "sort": { "field": "decisionDate", "dir": "desc" }, "limit": 6, "columns": [{ "key": "title", "label": "Decision" }, { "key": "decisionDate", "label": "Date" }] }
					},
					{
						"id": "dashboard-empty-state",
						"type": "custom",
						"title": "Welcome"
					}
				],
				"dateRange": {
					"enabled": true,
					"showHeaderPicker": false,
					"persistKey": "decidesk.dashboard.range",
					"default": { "preset": "all" },
					"presets": [
						{ "id": "last-7", "label": "7d", "days": 7 },
						{ "id": "last-30", "label": "30d", "days": 30 },
						{ "id": "last-90", "label": "90d", "days": 90 },
						{ "id": "all", "label": "All", "days": null }
