						"title": "Decisions",
						"content": { "label": "Decisions", "icon": "ScaleBalance", "valueColor": "#1a4a72", "route": { "name": "Decisions" }, "format": { "style": "number" }, "source": { "register": "decidesk", "schema": "decision", "metric": "count", "filter": { "decisionDate": { "gte": "@workspace.dateFrom?", "lte": "@workspace.dateTo?" } } } }
					},
					{
						"id": "upcoming-meetings-kpi",
						"type": "stat",
						"title": "Upcoming meetings",
						"content": { "label": "Upcoming meetings", "icon": "Calendar", "valueColor": "#0082c9", "route": { "name": "Meetings" }, "format": { "style": "number" }, "source": { "register": "decidesk", "schema": "meeting", "metric": "count", "filter": { "lifecycle": "scheduled", "scheduledDate": { "gte": "@workspace.dateFrom?", "lte": "@workspace.dateTo?" } } } }
					},
					{
						"id": "pending-votes-kpi",
						"type": "custom",
						"title": "Pending votes"
					},
					{
						"id": "overdue-actions-kpi",
						"type": "stat",
						"title": "Open action items",
						"content": { "label": "Open action items", "icon": "ClipboardList", "valueColor": "#c7860c", "route": { "name": "ActionItems" }, "format": { "style": "number" }, "source": { "register": "decidesk", "schema": "action-item", "metric": "count", "filter": { "taskStatus": ["open", "in-progress"], "dueDate": { "gte": "@workspace.dateFrom?", "lte": "@workspace.dateTo?" } } } }
					},
					{
						"id": "upcoming-meetings-list",
						"type": "object-list",
						"title": "Upcoming meetings",
						"content": { "register": "decidesk", "schema": "meeting", "filter": { "lifecycle": "scheduled" }, "sort": { "field": "scheduledDate", "dir": "asc" }, "limit": 6, "columns": [{ "key": "title", "label": "Meeting" }, { "key": "scheduledDate", "label": "Date" }] }
					},
					{
						"id": "pending-votes-list",
						"type": "custom",
						"title": "Pending votes"
					},
					{
						"id": "running-processes",
						"type": "custom",
						"title": "Running processes"
					},
					{
						"id": "my-action-items",
						"type": "custom",
						"title": "My action items"
					},
