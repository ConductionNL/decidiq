		{
			"id": "MotionDetail",
			"_note": "The motion page in the simple structure (openspec/changes/simple-decision-page). A motion is a decision, and its page gets the same header: the state as a pill, ONE primary button for the step that leaves the state, and a what-now card. The buttons post to the endpoint the Stage block uses (POST /api/motions/{id}/transition), so the server decides who may take a step, as it does today. `voting` has two ways out. Recording the motion as adopted is the primary button and recording it as rejected is a quick action beside it. Withdrawing and archiving stay in the Stage block, which is unchanged and still on the page. THE BLOCKS ARE NOT REGROUPED INTO TABS HERE: that is done for the decision page only.",
			"config": {
				"stageField": "lifecycle",
				"primaryActionByStage": {
					"draft": "motion-submit",
					"proposed": "motion-debate",
					"deliberating": "motion-vote",
					"voting": "motion-adopt",
					"decided": "motion-carry-out"
				},
				"quickActions": [
					"motion-reject",
					"motion-open-discussion"
				],
				"actionsMenu": {
					"showRefresh": false,
					"label": "More"
				},
				"statusPill": {
					"field": "lifecycle",
					"labels": {
						"draft": "Draft",
						"proposed": "Proposed",
						"deliberating": "Deliberating",
						"voting": "Voting",
						"decided": "Decided",
						"enacted": "Enacted",
						"archived": "Archived",
						"withdrawn": "Withdrawn"
					},
					"colorMap": {
						"draft": "default",
						"proposed": "primary",
						"deliberating": "primary",
						"voting": "warning",
						"decided": "success",
