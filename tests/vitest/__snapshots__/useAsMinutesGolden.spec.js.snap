// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`MeetingTranscriptionTab useAsMinutes() > creates new minutes when the meeting has none, also when the store answers null 1`] = `
{
  "calls": [
    {
      "fn": "ensureRelationType",
      "type": "minutes",
    },
    {
      "fn": "fetchCollection",
      "params": {
        "_limit": 20,
        "meeting": "m1",
      },
      "schema": "minutes",
    },
    {
      "fn": "saveObject",
      "object": {
        "draft": {
          "sections": [
            "s1",
          ],
        },
        "fresh": true,
        "meeting": "m1",
        "title": "Minutes",
      },
      "schema": "minutes",
    },
  ],
  "state": {
    "error": "",
    "usedNotice": "The kept sections are in the minutes. Open the minutes to review them.",
    "working": false,
  },
}
`;

