exports[`MeetingTranscriptionTab useAsMinutes() > refuses minutes past the draft stage 1`] = `
{
  "calls": [
    {
      "fn": "ensureRelationType",
      "type": "minutes",
    },
    {
      "fn": "fetchCollection",
      "params": {
        "_limit": 20,
        "meeting": "m1",
      },
      "schema": "minutes",
    },
  ],
  "state": {
    "error": "The minutes of this meeting are past the draft stage, so the AI draft was not written into them.",
    "usedNotice": "",
    "working": false,
  },
}
`;

