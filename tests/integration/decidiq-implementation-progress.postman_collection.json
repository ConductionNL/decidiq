                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ocs/v2.php/apps/provisioning_api/api/v1/config/apps/core/backgroundjobs_mode?format=json"
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{adminUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{adminPass}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const day = (n) => new Date(Date.now() - n * 86400000).toISOString().slice(0, 10);",
                  "pm.collectionVariables.set('runTag', 'nm-ip-' + Date.now());",
                  "pm.collectionVariables.set('silentDate', day(100));",
                  "pm.collectionVariables.set('recentDate', day(10));",
                  "pm.collectionVariables.set('cronRuns', '0');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('mode readable', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().ocs.data;",
                  "pm.collectionVariables.set('prevCronMode', (d && d.data) || 'ajax');"
                ]
              }
            }
          ]
        },
