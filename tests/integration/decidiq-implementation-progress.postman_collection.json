                "type": "text/javascript",
                "exec": [
                  "pm.test('cron answers', () => pm.expect(pm.response.code).to.be.oneOf([200,204]));",
                  "pm.collectionVariables.set('cronRuns', String(Number(pm.collectionVariables.get('cronRuns')) + 1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Secretary reads the No progress reported notification",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ocs/v2.php/apps/notifications/api/v2/notifications?format=json"
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{ipSecretaryUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{ipSecretaryPass}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tag = pm.collectionVariables.get('runTag');",
                  "const runs = Number(pm.collectionVariables.get('cronRuns'));",
                  "const list = (pm.response.json().ocs || {}).data || [];",
                  "const subjects = list.map((n) => String(n.subject || ''));",
                  "const ours = subjects.filter((s) => s.includes(tag));",
                  "const silent = ours.find((s) => s.includes(tag + ' silent motion'));",
                  "if (!silent && runs < 150) {",
                  "  // OpenRegister's ScheduledNotificationJob is one of many jobs; cron.php runs one per call.",
                  "  postman.setNextRequest('Run the next background job');",
                  "  return;",
                  "}",
                  "pm.test('the secretariat is told about the motion nobody reported on for 90 days', () => {",
                  "  pm.expect(silent, 'notification for the silent motion after ' + runs + ' cron runs').to.be.a('string');",
                  "  pm.expect(silent).to.match(/No progress reported|Geen voortgang gemeld/);",
                  "});",
                  "pm.test('a motion with a recent update is not reported', () => pm.expect(ours.some((s) => s.includes(tag + ' reported motion'))).to.eql(false));",
                  "pm.test('a completed motion is not reported', () => pm.expect(ours.some((s) => s.includes(tag + ' completed motion'))).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    },
