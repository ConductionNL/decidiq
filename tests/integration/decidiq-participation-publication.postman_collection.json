					"raw": "{\n  \"config\": {\n    \"newman-publication-body\": {\n      \"catalog\": \"newman-catalog\",\n      \"policy\": {\n        \"decision\": \"prompt-on-transition\",\n        \"minutes\": \"manual-only\",\n        \"agenda\": \"publish-everything-immediately\"\n      },\n      \"attendance\": \"full-roll-call\"\n    }\n  }\n}"
				},
