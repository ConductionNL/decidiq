		{
			"name": "POST publishBudgetResults publishes a NON-EMPTY allocation",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('publishBudgetResults: 200', () => pm.response.to.have.status(200));",
							"const s = pm.response.json().summary;",
							"pm.test('publishBudgetResults: returns a budget-results summary for this round', () => {",
							"  pm.expect(s, 'summary').to.be.an('object');",
							"  pm.expect(s.summaryType).to.eql('budget-results');",
							"  pm.expect(s.sourceId).to.eql(pm.collectionVariables.get('budgetId'));",
							"  pm.expect(s.totalAmount).to.eql(50000);",
							"});",
							"// The whole defect this pins: the round has one validated proposal carrying",
							"// one vote, and the published summary used to report none of it. Asserting",
							"// only 'summary is an object' would have been green the entire time.",
							"pm.test('publishBudgetResults: the round\\'s proposal is IN the published result', () => {",
							"  pm.expect(s.proposals, 'proposals').to.be.an('array').with.lengthOf(1);",
							"  pm.expect(s.proposals[0].title).to.eql('Newman advisory proposal');",
							"});",
							"pm.test('publishBudgetResults: participation and allocation are counted', () => {",
							"  pm.expect(s.participationCount, 'participationCount').to.eql(1);",
							"  pm.expect(s.allocatedAmount, 'allocatedAmount').to.eql(2000);",
							"});",
							"pm.test('publishBudgetResults: the round is marked as published', () => {",
							"  pm.expect(s.sourceObject.resultsPublished).to.eql(true);",
							"});"
						]
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{ "key": "username", "value": "{{adminUser}}", "type": "string" },
						{ "key": "password", "value": "{{adminPass}}", "type": "string" }
					]
				},
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" },
					{ "key": "OCS-APIRequest", "value": "true" }
				],
				"url": {
					"raw": "{{baseUrl}}/index.php/apps/decidiq/api/participation/budgets/{{budgetId}}/publish",
					"host": ["{{baseUrl}}"],
					"path": ["index.php", "apps", "decidiq", "api", "participation", "budgets", "{{budgetId}}", "publish"]
				}
			}
		},

