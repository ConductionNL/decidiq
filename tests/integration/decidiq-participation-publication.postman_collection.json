							"// 'the enum was checked' from 'something went wrong'.",
							"pm.test('castAdvisoryVote bad value: 400', () => pm.response.to.have.status(400));",
							"pm.test('castAdvisoryVote bad value: names the allowed values', () => {",
							"  pm.expect(pm.response.json().message).to.match(/voor.*tegen/);",
							"});"
