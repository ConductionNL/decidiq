		{
			"name": "PUT /api/settings/publication-config drops values outside the enums",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('setPublicationConfig: 200', () => pm.response.to.have.status(200));",
							"const b = pm.response.json();",
							"pm.test('setPublicationConfig: reports success and echoes the cleaned config', () => {",
							"  pm.expect(b.success).to.eql(true);",
							"  pm.expect(b).to.have.property('config');",
							"});",
							"const body = b.config['newman-publication-body'];",
							"pm.test('setPublicationConfig: the body survives the round trip', () => {",
							"  pm.expect(body, 'newman-publication-body').to.be.an('object');",
							"  pm.expect(body.catalog).to.eql('newman-catalog');",
							"});",
							"// PublicationConfigService::save() validates both enums and DROPS what does",
							"// not match, rather than rejecting the request. That silent narrowing is the",
							"// contract, so it is asserted rather than assumed.",
							"pm.test('setPublicationConfig: a policy value outside POLICIES is dropped', () => {",
							"  pm.expect(body.policy).to.not.have.property('agenda');",
							"});",
							"pm.test('setPublicationConfig: a valid policy value is kept, per source type', () => {",
							"  pm.expect(body.policy.decision).to.eql('prompt-on-transition');",
							"  pm.expect(body.policy.minutes).to.eql('manual-only');",
							"});",
							"pm.test('setPublicationConfig: an attendance value outside ATTENDANCE_POLICIES falls back to counts', () => {",
							"  pm.expect(body.attendance).to.eql('counts');",
							"});"
						]
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{ "key": "username", "value": "{{adminUser}}", "type": "string" },
						{ "key": "password", "value": "{{adminPass}}", "type": "string" }
					]
