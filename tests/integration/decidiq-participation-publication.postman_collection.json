		{
			"name": "POST castAdvisoryVote records the vote (201) and tallies it",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('castAdvisoryVote: 201', () => pm.response.to.have.status(201));",
							"const b = pm.response.json();",
							"pm.test('castAdvisoryVote: returns the stored CitizenVote', () => {",
							"  pm.expect(b.vote, 'vote').to.be.an('object');",
							"  pm.expect(b.vote.voteValue).to.eql('voor');",
							"  pm.expect(b.vote.voterId).to.eql(pm.collectionVariables.get('adminUser'));",
							"  pm.expect(b.vote.proposalId).to.eql(pm.collectionVariables.get('proposalId'));",
							"});",
							"// The tally is the assertion that matters. It came back 0 for every vote",
							"// ever cast while the dedup/tally query filtered on the schema slug, and a",
							"// test that only checked the 201 would have been green throughout.",
							"pm.test('castAdvisoryVote: the response carries the recomputed tally', () => {",
							"  pm.expect(b.votesFor, 'votesFor').to.eql(1);",
							"  pm.expect(b.votesAgainst, 'votesAgainst').to.eql(0);",
							"});"
						]
					}
				}
			],
