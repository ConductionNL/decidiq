{
	"info": {
		"_postman_id": "b7e3f2a1-44d2-4a0e-9c1b-202606120001",
		"name": "Decidiq Admin Settings (admin-settings-v1)",
		"description": "Contract tests for the admin-settings surface: member-import endpoints (Nextcloud group listing, group members, CSV email matching with validation + row cap) and the organization configuration round-trip. Auth model matches decidiq-lifecycle: collection-level noauth, per-request basic auth as {{adminUser}}, {{noAuthBase}} for unauthenticated 401 probes, and a temporary non-admin account for the 403 posture on the AuthorizedAdminSetting-gated endpoints. Idempotent: seeds and tears down its own non-admin user and resets the organization keys. @spec openspec/specs/admin-settings/spec.md",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": { "type": "noauth" },
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Newman keeps ONE cookie jar per host, shared by every request in the run.",
					"// Nextcloud resolves a logged-in session from that jar BEFORE it reads the",
					"// Basic auth header, so a request carrying both runs as whoever authenticated",
					"// last — not as the account in its own Authorization header.",
					"//",
					"// That is decidesk#443: four '403' assertions here saw 200 because the admin",
					"// session from the setup requests was still in the jar, and were read as a",
					"// missing AuthorizedAdminSetting gate. It cuts the other way too: once the",
					"// non-admin has a session, later admin-only requests run as the non-admin.",
					"//",
					"// Every request in this collection asserts on WHO is calling, so the jar is",
					"// dropped before each one and the Basic credentials are the only identity",
					"// on the wire. The 'Identity guard' request proves this holds.",
					"pm.cookies.jar().clear(pm.variables.replaceIn('{{baseUrl}}'), function () {});"
				]
			}
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "noAuthBase", "value": "http://127.0.0.1:8080" },
		{ "key": "adminUser", "value": "admin" },
		{ "key": "adminPass", "value": "admin" },
		{ "key": "nonAdminUser", "value": "decidesk-admset-nonadmin" },
		{ "key": "nonAdminPass", "value": "Decidiq-NonAdmin!42x" }
	],
	"item": [
		{
			"name": "0. Setup",
			"item": [
				{
					"name": "Create non-admin probe user",
					"request": {
						"method": "POST",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"header": [
							{ "key": "OCS-APIRequest", "value": "true" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "userid", "value": "{{nonAdminUser}}" },
								{ "key": "password", "value": "{{nonAdminPass}}" }
							]
						},
						"url": {
							"raw": "{{baseUrl}}/ocs/v2.php/cloud/users?format=json",
							"host": [ "{{baseUrl}}" ],
							"path": [ "ocs", "v2.php", "cloud", "users" ],
							"query": [ { "key": "format", "value": "json" } ]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// 200 = created; 400 with OCS statuscode 102 = already exists (idempotent re-run).",
									"pm.test('Setup: non-admin probe user available', () => {",
									"    if (pm.response.code === 200) { return; }",
									"    const sc = pm.response.json()?.ocs?.meta?.statuscode;",
									"    pm.expect(sc, 'user already exists is acceptable').to.eql(102);",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "1. Group listing (admin)",
			"item": [
				{
					"name": "GET groups as admin lists Nextcloud groups",
					"request": {
						"method": "GET",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"header": [ { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" } ],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/decidiq/api/member-import/groups",
							"host": [ "{{baseUrl}}" ],
							"path": [ "index.php", "apps", "decidiq", "api", "member-import", "groups" ]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('admin group listing is 200', () => pm.response.to.have.status(200));",
									"pm.test('groups array contains the admin group with id/displayName/userCount', () => {",
									"    const groups = pm.response.json().groups;",
									"    pm.expect(groups).to.be.an('array').that.is.not.empty;",
									"    const adminGroup = groups.find(g => g.id === 'admin');",
									"    pm.expect(adminGroup, 'admin group present').to.exist;",
									"    pm.expect(adminGroup.displayName).to.be.a('string');",
									"    pm.expect(adminGroup.userCount).to.be.a('number');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET group members as admin returns uid/displayName/email rows",
					"request": {
						"method": "GET",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"header": [ { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" } ],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/decidiq/api/member-import/groups/admin/members",
							"host": [ "{{baseUrl}}" ],
							"path": [ "index.php", "apps", "decidiq", "api", "member-import", "groups", "admin", "members" ]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('admin group members is 200', () => pm.response.to.have.status(200));",
									"pm.test('members rows expose uid, displayName and email', () => {",
									"    const members = pm.response.json().members;",
									"    pm.expect(members).to.be.an('array').that.is.not.empty;",
									"    const admin = members.find(m => m.uid === pm.variables.get('adminUser'));",
									"    pm.expect(admin, 'admin uid present in the admin group').to.exist;",
									"    pm.expect(admin.displayName).to.be.a('string');",
									"    pm.expect(admin).to.have.property('email');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET members of unknown group is 404",
					"request": {
						"method": "GET",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"header": [ { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" } ],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/decidiq/api/member-import/groups/decidesk-no-such-group/members",
							"host": [ "{{baseUrl}}" ],
							"path": [ "index.php", "apps", "decidiq", "api", "member-import", "groups", "decidesk-no-such-group", "members" ]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('unknown group is 404 not 500', () => pm.response.to.have.status(404));"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "2. Email matching (admin)",
			"item": [
				{
					"name": "POST match resolves and validates emails",
					"request": {
						"method": "POST",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" } ],
						"body": {
							"mode": "raw",
							"raw": "{\"emails\": [\"nobody-matches-this@decidesk-test.invalid\", \"not-an-email\"]}"
						},
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/decidiq/api/member-import/match",
							"host": [ "{{baseUrl}}" ],
							"path": [ "index.php", "apps", "decidiq", "api", "member-import", "match" ]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('match is 200', () => pm.response.to.have.status(200));",
									"pm.test('unmatched and malformed emails map to null', () => {",
									"    const matches = pm.response.json().matches;",
									"    pm.expect(matches).to.be.an('object');",
									"    pm.expect(matches['nobody-matches-this@decidesk-test.invalid']).to.eql(null);",
									"    pm.expect(matches['not-an-email']).to.eql(null);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST match with non-array payload is 422",
					"request": {
						"method": "POST",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" } ],
						"body": {
							"mode": "raw",
							"raw": "{\"emails\": \"not-a-list\"}"
						},
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/decidiq/api/member-import/match",
							"host": [ "{{baseUrl}}" ],
							"path": [ "index.php", "apps", "decidiq", "api", "member-import", "match" ]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('non-array emails payload is 422', () => pm.response.to.have.status(422));"
								]
							}
						}
					]
				},
				{
					"name": "POST match beyond the 500-row cap is 413",
					"request": {
						"method": "POST",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" } ],
						"body": {
							"mode": "raw",
							"raw": "{\"emails\": {{admsetBigEmailList}}}"
						},
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/decidiq/api/member-import/match",
							"host": [ "{{baseUrl}}" ],
							"path": [ "index.php", "apps", "decidiq", "api", "member-import", "match" ]
						}
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const emails = [];",
									"for (let i = 0; i < 501; i++) { emails.push(`cap-test-${i}@decidesk-test.invalid`); }",
									"pm.collectionVariables.set('admsetBigEmailList', JSON.stringify(emails));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('501 emails trips the server-side row cap (413)', () => pm.response.to.have.status(413));"
								]
							}
						}
					]
				}
			]
		},
		{
