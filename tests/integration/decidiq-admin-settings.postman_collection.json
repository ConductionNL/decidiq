					"name": "GET groups as non-admin (403)",
					"request": {
						"method": "GET",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{nonAdminUser}}", "type": "string" }, { "key": "password", "value": "{{nonAdminPass}}", "type": "string" } ] },
						"header": [ { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" } ],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/decidiq/api/member-import/groups",
							"host": [ "{{baseUrl}}" ],
							"path": [ "index.php", "apps", "decidiq", "api", "member-import", "groups" ]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
