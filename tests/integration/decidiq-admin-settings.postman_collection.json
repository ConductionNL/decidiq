						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{nonAdminUser}}", "type": "string" }, { "key": "password", "value": "{{nonAdminPass}}", "type": "string" } ] },
						"header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" } ],
