		{
			"name": "9. Teardown",
			"item": [
				{
					"name": "Reset organization settings",
					"request": {
						"method": "POST",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }, { "key": "OCS-APIRequest", "value": "true" } ],
						"body": {
							"mode": "raw",
							"raw": "{\"organisation_name\": \"\", \"organisation_logo\": \"\", \"organisation_timezone\": \"\", \"organisation_locale\": \"\", \"organisation_currency\": \"\"}"
						},
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/decidiq/api/settings",
							"host": [ "{{baseUrl}}" ],
							"path": [ "index.php", "apps", "decidiq", "api", "settings" ]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Teardown: organization settings reset (200)', () => pm.response.to.have.status(200));"
								]
							}
						}
					]
				},
				{
					"name": "Delete non-admin probe user",
					"request": {
						"method": "DELETE",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"header": [ { "key": "OCS-APIRequest", "value": "true" }, { "key": "Accept", "value": "application/json" } ],
						"url": {
							"raw": "{{baseUrl}}/ocs/v2.php/cloud/users/{{nonAdminUser}}?format=json",
							"host": [ "{{baseUrl}}" ],
							"path": [ "ocs", "v2.php", "cloud", "users", "{{nonAdminUser}}" ],
							"query": [ { "key": "format", "value": "json" } ]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Teardown: non-admin probe user removed (2xx or already gone)', () => {",
									"    pm.expect([200, 204, 404]).to.include(pm.response.code);",
									"});"
								]
							}
						}
					]
				}
			]
		}
	]
}
