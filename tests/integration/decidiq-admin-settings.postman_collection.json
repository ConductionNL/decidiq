						"method": "GET",
						"auth": { "type": "noauth" },
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": {
							"raw": "{{noAuthBase}}/index.php/apps/decidiq/api/member-import/groups",
							"host": [ "{{noAuthBase}}" ],
							"path": [ "index.php", "apps", "decidiq", "api", "member-import", "groups" ]
						}
