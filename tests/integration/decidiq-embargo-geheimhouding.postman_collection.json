    {
      "name": "1. Public feed while restricted and embargoed",
      "item": [
        {
          "name": "Feed while restricted",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Feed while restricted: the feed answers 200 without a session', () => pm.response.to.have.status(200));",
                  "const guids = [...pm.response.text().matchAll(/<guid[^>]*>([^<]+)<\\/guid>/g)].map((m) => m[1].trim());",
                  "pm.test('Feed while restricted: lists {{plainDoc}}', () => pm.expect(guids).to.include(pm.collectionVariables.get('plainDoc')));",
                  "pm.test('Feed while restricted: lists {{releasedDoc}}', () => pm.expect(guids).to.include(pm.collectionVariables.get('releasedDoc')));",
                  "pm.test('Feed while restricted: leaves out {{embargoedDoc}}', () => pm.expect(guids).to.not.include(pm.collectionVariables.get('embargoedDoc')));",
                  "pm.test('Feed while restricted: leaves out {{restrictedDoc}}', () => pm.expect(guids).to.not.include(pm.collectionVariables.get('restrictedDoc')));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/index.php/apps/decidiq/feed/ori/documents.rss"
            }
          }
        }
      ]
    },
