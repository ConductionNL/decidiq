					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('certStatus authenticated: 200 (not a router 404, not an auth rejection)', () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"pm.test('certStatus: documented contract shape', () => {",
									"    pm.expect(b).to.have.property('valid');",
									"    pm.expect(b).to.have.property('message');",
									"});"
								]
							}
						}
					]
				},
