									"key": "format",
									"value": "json"
								}
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// 200 = created; 400 with OCS statuscode 102 = already exists (idempotent re-run).",
									"pm.test('Setup: grantor probe user available', () => {",
									"    if (pm.response.code === 200) { return; }",
									"    const sc = pm.response.json()?.ocs?.meta?.statuscode;",
									"    pm.expect(sc, 'user already exists is acceptable').to.eql(102);",
