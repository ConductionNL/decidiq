		{
			"name": "2. eIDAS signing-endpoint reachability + auth posture",
			"description": "REQ-SFEC-002: real-HTTP e2e proving POST /api/eidas/validate-cert is reachable and authentication-enforced by the real Nextcloud middleware chain. Full external QES provider round-trip (initiate -> sign -> finalize) is explicitly out of scope (requires a live signing provider).",
			"item": [
				{
					"name": "certStatus reachable for an authenticated caller (200, contract shape)",
					"request": {
						"method": "POST",
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{adminUser}}",
