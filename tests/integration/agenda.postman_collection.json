{
	"info": {
		"name": "Decidesk — Agenda Management (p2)",
		"description": "Integration tests for the 4 agenda management API endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{admin_user}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{admin_password}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "POST /api/agendas/{meetingId}/publish",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/apps/decidesk/api/agendas/{{meetingId}}/publish",
					"host": ["{{baseUrl}}"],
					"path": ["apps", "decidesk", "api", "agendas", "{{meetingId}}", "publish"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Response has success flag', function () {",
							"    var json = pm.response.json();",
							"    pm.expect(json.success).to.eql(true);",
							"});",
							"pm.test('Response has notifications count', function () {",
							"    var json = pm.response.json();",
							"    pm.expect(json.notifications).to.be.a('number');",
							"});"
						]
					}
				}
			]
		},
		{
			"name": "POST /api/agendas/{meetingId}/publish — 400 empty agenda",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/apps/decidesk/api/agendas/{{emptyMeetingId}}/publish",
					"host": ["{{baseUrl}}"],
					"path": ["apps", "decidesk", "api", "agendas", "{{emptyMeetingId}}", "publish"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status is 400 for empty agenda', function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"pm.test('Response has success false', function () {",
							"    var json = pm.response.json();",
							"    pm.expect(json.success).to.eql(false);",
							"});"
						]
					}
				}
			]
		},
