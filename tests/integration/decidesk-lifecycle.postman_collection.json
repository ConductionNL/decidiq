{
	"info": {
		"name": "Decidiq Decision Lifecycle Contract Suite",
		"description": "Newman contract tests for the guarded decision state machine (decision-state-machine-v1): GET /api/decisions/{id}/transitions and POST /api/decisions/{id}/transition. Locks the transition-map contract (allowed actions per state), the 422 rejection envelope for invalid/unknown transitions, and the 401 authorization posture. Self-contained: seeds its own draft Decision via the OpenRegister object API and tears it down.\n\nAUTH MODEL (same as decidesk.postman_collection.json): collection auth is noauth; every authenticated request carries an EXPLICIT basic-auth block plus 'OCS-APIRequest: true'. The no-auth request carries NEITHER and targets {{noAuthBase}} so the host-scoped NC session cookie never leaks to it.\n\n@spec openspec/specs/decision-management/spec.md",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "noauth"
	},
	"item": [
		{
			"name": "0. Setup",
			"item": [
				{
					"name": "Seed draft decision",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Setup: draft decision created (201)', () => pm.response.to.have.status(201));",
									"const b = pm.response.json();",
									"const id = (b['@self'] && b['@self'].id) || b.id;",
									"pm.expect(id, 'decision id captured').to.be.a('string');",
									"pm.collectionVariables.set('lifecycleDecisionId', id);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{adminUser}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{adminPass}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/decidesk/decision",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"index.php",
								"apps",
								"openregister",
								"api",
								"objects",
								"decidesk",
								"decision"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"decisionType\": \"meeting-outcome\",\n  \"title\": \"Newman lifecycle decision\",\n  \"text\": \"Contract test decision.\",\n  \"lifecycle\": \"draft\"\n}"
						}
					}
				}
			]
		},
		{
			"name": "1. Transitions contract",
			"item": [
				{
					"name": "GET transitions exposes draft actions",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Lifecycle: transitions contract (200)', () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"pm.expect(b.lifecycle).to.eql('draft');",
									"pm.expect(b.states).to.eql(['draft','proposed','deliberating','voting','decided','enacted','archived']);",
									"const actions = (b.actions || []).map(a => a.action);",
									"pm.expect(actions).to.include('propose');"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{adminUser}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{adminPass}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/decidesk/api/decisions/{{lifecycleDecisionId}}/transitions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"index.php",
								"apps",
								"decidesk",
								"api",
								"decisions",
								"{{lifecycleDecisionId}}",
								"transitions"
							]
						}
					}
				},
