							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{noAuthBase}}/index.php/apps/decidiq/api/meetings/{{maTemplateMeetingId}}/package",
							"host": ["{{noAuthBase}}"],
							"path": ["index.php", "apps", "decidiq", "api", "meetings", "{{maTemplateMeetingId}}", "package"]
						},
						"body": {
							"mode": "raw",
							"raw": "{}"
						}
					}
				},
				{
