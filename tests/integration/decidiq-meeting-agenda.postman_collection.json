		},
		{
			"name": "9. Teardown",
			"item": [
				{
					"name": "Delete generated series instances",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Teardown: series instances listed (200)', () => pm.response.to.have.status(200));",
									"const series = pm.collectionVariables.get('maSeriesSlug');",
									"const templateId = pm.collectionVariables.get('maTemplateMeetingId');",
									"if (series) {",
									"    const body = pm.response.json();",
									"    const rows = body.results || body.items || [];",
									"    const authHeader = 'Basic ' + Buffer.from(pm.variables.get('adminUser') + ':' + pm.variables.get('adminPass')).toString('base64');",
									"    rows.forEach((row) => {",
									"        const id = (row['@self'] && row['@self'].id) || row.id;",
									"        if (!id || id === templateId) { return; }",
									"        pm.sendRequest({",
									"            url: pm.variables.get('baseUrl') + '/index.php/apps/openregister/api/objects/decidesk/meeting/' + id,",
									"            method: 'DELETE',",
									"            header: { Authorization: authHeader, 'OCS-APIRequest': 'true', Accept: 'application/json' },",
									"        }, () => {});",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{ "key": "username", "value": "{{adminUser}}", "type": "string" },
								{ "key": "password", "value": "{{adminPass}}", "type": "string" }
							]
						},
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "OCS-APIRequest", "value": "true" }
						],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/decidesk/meeting?series={{maSeriesSlug}}&_limit=100",
							"host": ["{{baseUrl}}"],
							"path": ["index.php", "apps", "openregister", "api", "objects", "decidesk", "meeting"],
							"query": [
								{ "key": "series", "value": "{{maSeriesSlug}}" },
								{ "key": "_limit", "value": "100" }
							]
						}
					}
				},
				{
					"name": "Delete template meeting",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Teardown: template meeting deleted (2xx)', () => {",
									"    pm.expect(pm.response.code).to.be.within(200, 299);",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{ "key": "username", "value": "{{adminUser}}", "type": "string" },
								{ "key": "password", "value": "{{adminPass}}", "type": "string" }
							]
						},
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "OCS-APIRequest", "value": "true" }
						],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/decidesk/meeting/{{maTemplateMeetingId}}",
							"host": ["{{baseUrl}}"],
							"path": ["index.php", "apps", "openregister", "api", "objects", "decidesk", "meeting", "{{maTemplateMeetingId}}"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "maTemplateMeetingId", "value": "" },
		{ "key": "maSeriesSlug", "value": "" }
	]
}
