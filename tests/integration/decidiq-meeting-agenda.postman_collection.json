						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pattern\": { \"frequency\": \"yearly\", \"interval\": 1, \"until\": \"2030-01-01\" }\n}"
						}
					}
				},
				{
					"name": "POST series unknown meeting (422)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Series: unknown meeting rejected (422)', () => pm.response.to.have.status(422));"
								]
