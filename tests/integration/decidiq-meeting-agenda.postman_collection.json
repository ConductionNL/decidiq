					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{ "key": "username", "value": "{{adminUser}}", "type": "string" },
								{ "key": "password", "value": "{{adminPass}}", "type": "string" }
							]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "OCS-APIRequest", "value": "true" }
						],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/decidiq/api/meetings/00000000-0000-4000-8000-000000000000/series",
							"host": ["{{baseUrl}}"],
							"path": ["index.php", "apps", "decidiq", "api", "meetings", "00000000-0000-4000-8000-000000000000", "series"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pattern\": { \"frequency\": \"monthly\", \"interval\": 1, \"until\": \"2027-08-31\" }\n}"
						}
					}
				},
				{
					"name": "POST series happy path (200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Series: generation succeeds (200)', () => pm.response.to.have.status(200));",
									"const b = pm.response.json();",
									"pm.test('Series: success true with series slug', () => {",
									"    pm.expect(b.success).to.eql(true);",
									"    pm.expect(b.series).to.be.a('string').and.to.not.be.empty;",
									"});",
									"pm.test('Series: 4 monthly instances Apr→Aug (template date excluded)', () => {",
									"    pm.expect(b.instances).to.be.an('array');",
									"    pm.expect(b.instances.length).to.eql(4);",
									"});",
									"pm.test('Series: not truncated', () => pm.expect(b.truncated).to.eql(false));",
									"pm.collectionVariables.set('maSeriesSlug', b.series);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{ "key": "username", "value": "{{adminUser}}", "type": "string" },
								{ "key": "password", "value": "{{adminPass}}", "type": "string" }
							]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "OCS-APIRequest", "value": "true" }
						],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/decidiq/api/meetings/{{maTemplateMeetingId}}/series",
							"host": ["{{baseUrl}}"],
							"path": ["index.php", "apps", "decidiq", "api", "meetings", "{{maTemplateMeetingId}}", "series"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pattern\": { \"frequency\": \"monthly\", \"interval\": 1, \"until\": \"2027-08-31\" }\n}"
						}
					}
				}
			]
		},
		{
			"name": "2. Package contract",
			"item": [
