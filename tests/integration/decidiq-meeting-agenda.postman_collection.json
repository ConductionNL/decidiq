					"name": "POST package unauthenticated (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Package: unauthenticated rejected (401)', () => pm.response.to.have.status(401));"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
