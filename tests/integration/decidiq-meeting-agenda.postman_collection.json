{
	"info": {
		"name": "Decidiq meeting+agenda gaps contract (series + package)",
		"description": "Contract tests for the meeting-agenda-gaps-v1 endpoints: POST /api/meetings/{id}/series (recurring series generation) and POST /api/meetings/{id}/package (document package assembly). Self-contained: seeds its own template meeting through the OpenRegister object API and tears down the template plus every generated series instance.\n\nSPDX-License-Identifier: EUPL-1.2\nSPDX-FileCopyrightText: 2026 Conduction B.V.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "noauth"
	},
	"item": [
		{
			"name": "0. Setup",
			"item": [
				{
					"name": "Seed template meeting",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Setup: template meeting created (201)', () => pm.response.to.have.status(201));",
									"const b = pm.response.json();",
									"const id = (b['@self'] && b['@self'].id) || b.id;",
									"pm.expect(id, 'meeting id captured').to.be.a('string');",
									"pm.collectionVariables.set('maTemplateMeetingId', id);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{ "key": "username", "value": "{{adminUser}}", "type": "string" },
								{ "key": "password", "value": "{{adminPass}}", "type": "string" }
							]
						},
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" },
							{ "key": "OCS-APIRequest", "value": "true" }
						],
						"url": {
							"raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/decidesk/meeting",
							"host": ["{{baseUrl}}"],
							"path": ["index.php", "apps", "openregister", "api", "objects", "decidesk", "meeting"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Newman series template\",\n  \"meetingType\": \"regular\",\n  \"meetingMode\": \"in-person\",\n  \"scheduledDate\": \"2027-04-15T14:00:00Z\",\n  \"lifecycle\": \"scheduled\"\n}"
						}
					}
				}
			]
		},
		{
			"name": "1. Series contract",
			"item": [
				{
					"name": "POST series unauthenticated (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Series: unauthenticated rejected (401)', () => pm.response.to.have.status(401));"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
