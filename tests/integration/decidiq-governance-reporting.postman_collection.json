					"script": {
						"type": "text/javascript",
						"exec": [
							"// process() returns 200 when processQueue() reports success and 422",
							"// when it does not. On a clean instance the queue is empty, which is",
							"// not an error condition the test can control, so both are accepted —",
							"// and the response SHAPE is asserted either way, so a 422 still has to",
							"// be a well-formed answer from the controller rather than an HTML",
							"// error page or an empty body.",
							"pm.test('Queue process: 200 (work done) or 422 (nothing processable)', () => pm.expect(pm.response.code).to.be.oneOf([200, 422]));",
