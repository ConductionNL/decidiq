                  "pm.collectionVariables.set('runTag', tag);",
                  "pm.collectionVariables.set('validFrom', new Date(Date.now() - 30*86400000).toISOString().slice(0,10));",
                  "pm.collectionVariables.set('pastDate', new Date(Date.now() - 86400000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('body created', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));",
