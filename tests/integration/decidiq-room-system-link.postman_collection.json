    {
      "name": "1. Who writes and reads the room system",
      "item": [
        {
          "name": "The synchronisation user reads the seat on the participant (REQ-RCSL-002)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
