            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rsSyncUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{rsSyncPass}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('readable by the synchronisation user', () => pm.response.to.have.status(200));",
                  "pm.test('roomSeat is present', () => pm.expect(pm.response.json().roomSeat).to.eql('12'));"
                ]
              }
            }
          ]
        },
