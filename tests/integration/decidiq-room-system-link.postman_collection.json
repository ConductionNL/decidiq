          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refused', () => pm.expect(pm.response.code).to.be.oneOf([401,403]));",
                  "if (pm.response.code < 300) {",
                  "  const b = pm.response.json();",
                  "  pm.collectionVariables.set('strayId', (b['@self'] && b['@self'].id) || b.id);",
                  "}"
                ]
              }
            }
          ]
        },
