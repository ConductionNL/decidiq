       ],
       "query": [
        {
         "key": "format",
         "value": "json"
        }
       ]
      },
      "auth": {
       "type": "basic",
       "basic": [
        {
         "key": "username",
         "value": "{{adminUser}}",
         "type": "string"
        },
        {
         "key": "password",
         "value": "{{adminPass}}",
         "type": "string"
        }
       ]
      },
      "body": {
       "mode": "urlencoded",
       "urlencoded": [
        {
         "key": "groupid",
         "value": "decidiq-secretariat"
        }
       ]
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const tag = 'newman-drm-' + Date.now();",
         "pm.collectionVariables.set('runTag', tag);",
         "pm.collectionVariables.set('pastDate', new Date(Date.now() - 86400000).toISOString());",
         "pm.collectionVariables.set('futureDate', new Date(Date.now() + 30*86400000).toISOString());",
         "pm.collectionVariables.set('year', new Date().getFullYear());"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('group exists', () => pm.expect(pm.response.code).to.be.oneOf([200,400]));"
        ]
       }
      }
     ]
    },
