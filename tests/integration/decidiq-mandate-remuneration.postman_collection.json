      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const rows = (pm.response.json().results || []);",
         "const ids = rows.map(r => (r['@self'] && r['@self'].id) || r.id);",
         "pm.test('answered', () => pm.expect(pm.response.code).to.be.oneOf([200,403]));",
         "pm.test('the undisclosed record is not returned', () => pm.expect(ids).to.not.include(pm.collectionVariables.get('hiddenId')));",
         "pm.test('the not-yet-published record is not returned', () => pm.expect(ids).to.not.include(pm.collectionVariables.get('scheduledId')));"
        ]
       }
      }
     ]
