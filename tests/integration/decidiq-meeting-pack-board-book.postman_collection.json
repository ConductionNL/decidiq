  {
   "name": "2. Status",
   "item": [
    {
     "name": "Status as the secretary (200, contract shape)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('Status is 200', () => pm.response.to.have.status(200));",
         "const b = pm.response.json();",
         "pm.test('state is one of the compile states', () => pm.expect(b.state).to.be.oneOf(['idle', 'queued', 'running', 'done', 'failed']));",
         "pm.test('the compile just requested is visible (not idle)', () => pm.expect(b.state).to.not.eql('idle'));",
         "pm.test('freshness fields are present and typed', () => {",
         "    pm.expect(b.latestVersion).to.be.a('number');",
         "    pm.expect(b.currentFingerprint).to.be.a('string').and.have.length.above(0);",
         "    pm.expect(b.outdated).to.be.a('boolean');",
         "    pm.expect(b.skipped).to.be.an('array');",
         "    pm.expect(b.deliveryFailures).to.be.an('array');",
         "});",
         "pm.test('without a compiled version the pack is not outdated', () => {",
         "    if (b.latestVersion === 0) { pm.expect(b.outdated).to.eql(false); pm.expect(b.latestFingerprint).to.eql(null); }",
         "});"
        ]
       }
      }
     ],
