								"exec": [
									"// The open-round happy path needs a motion in 'deliberating' (open()",
									"// transitions motion deliberating -> voting and would mutate the shared",
									"// seed motion). Create a DEDICATED deliberating motion for this test so",
									"// the later 'proposed -> deliberating' test keeps its own seed motion.",
									"const base = pm.collectionVariables.get('baseUrl');",
									"const auth = 'Basic ' + btoa(pm.collectionVariables.get('adminUser') + ':' + pm.collectionVariables.get('adminPass'));",
									"pm.sendRequest({",
									"  url: base + '/index.php/apps/openregister/api/objects/decidesk/decision',",
									"  method: 'POST',",
									"  header: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'OCS-APIRequest': 'true', 'Authorization': auth },",
									"  body: { mode: 'raw', raw: JSON.stringify({ title: 'Newman Open Motion', text: 'Round-open motion', motionType: 'motion', proposer: 'Newman Admin', lifecycle: 'deliberating', meeting: pm.collectionVariables.get('meetingId') }) }",
									"}, function (err, res) {",
									"  if (!err && res) { const b = res.json(); const id = (b['@self'] && b['@self'].id) || b.id; pm.collectionVariables.set('openMotionId', id); }",
									"});"
								]
							}
						},
