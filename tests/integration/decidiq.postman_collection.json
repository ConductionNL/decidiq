									"// request-body meetingId. ParticipantResolver now resolves the seeded",
									"// chair because it reads the flat field-keyed relation map",
									"// ('@self.relations.governanceBody') the OR object API produces, so the",
									"// admin chair is recognised. checkQuorum() was fixed the same way, so",
									"// quorum (quorumRequired=1, 1 active chair) is met and the round opens.",
									"pm.test('Open: round opens for the seeded chair (201)', () => pm.response.to.have.status(201));",
									"pm.test('Open: response carries the voting-round id', () => { const b = pm.response.json(); const id = (b['@self'] && b['@self'].id) || b.id; pm.expect(id, 'voting-round id').to.be.a('string'); });"
