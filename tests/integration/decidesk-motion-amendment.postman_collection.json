					"event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Teardown: meeting deleted', () => pm.expect(pm.response.code, 'status').to.be.oneOf([200, 204, 404]));" ] } } ],
					"request": {
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"method": "DELETE",
