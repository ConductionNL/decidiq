					"event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Teardown: chair participant deleted', () => pm.expect(pm.response.code, 'status').to.be.oneOf([200, 204, 404]));" ] } } ],
					"request": {
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"method": "DELETE",
						"header": [ { "key": "OCS-APIRequest", "value": "true" } ],
						"url": { "raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/decidesk/participant/{{maChairId}}", "host": [ "{{baseUrl}}" ], "path": [ "index.php", "apps", "openregister", "api", "objects", "decidesk", "participant", "{{maChairId}}" ] }
					}
				},
				{
					"name": "Delete governance body",
					"event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Teardown: governance body deleted', () => pm.expect(pm.response.code, 'status').to.be.oneOf([200, 204, 404]));" ] } } ],
					"request": {
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
						"method": "DELETE",
						"header": [ { "key": "OCS-APIRequest", "value": "true" } ],
						"url": { "raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/decidesk/governance-body/{{maGovBodyId}}", "host": [ "{{baseUrl}}" ], "path": [ "index.php", "apps", "openregister", "api", "objects", "decidesk", "governance-body", "{{maGovBodyId}}" ] }
					}
