		{
			"name": "Seed",
			"item": [
				{
					"name": "Seed adopted motion, decided 120 days ago",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const daysAgo = (n) => new Date(Date.now() - n * 86400000).toISOString().slice(0, 10);",
									"pm.environment.set('decisionDate', daysAgo(120));",
									"pm.environment.set('motionTitle', 'Newman motie meer groen in de wijk ' + Date.now());"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('adopted motion created (201)', () => pm.response.to.have.status(201));",
									"const b = pm.response.json();",
									"const id = (b['@self'] && b['@self'].id) || b.id;",
									"pm.expect(id).to.be.a('string');",
									"pm.environment.set('motionId', id);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{adminUser}}",
									"type": "string"
								},
								{
