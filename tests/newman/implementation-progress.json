		{
			"name": "Reminder",
			"item": [
				{
					"name": "The secretariat was told: No progress reported",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const rows = Array.isArray(body) ? body : (body.results || []);",
									"const title = pm.environment.get('motionTitle');",
									"const hit = rows.find((row) => JSON.stringify(row).includes(title));",
									"pm.test('a notification names the silent motion', () => pm.expect(hit, 'run cron between the Seed and Reminder passes').to.not.be.undefined);",
									"pm.test('it is the no-progress reminder', () => pm.expect(JSON.stringify(hit)).to.match(/No progress reported|Geen voortgang gemeld/));"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
