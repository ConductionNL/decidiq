                            "raw": "{\"person\": \"{{personId}}\", \"identityType\": \"bsn\", \"number\": \"111222333\"}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "// With portaliq the account is provisioned and the claim written (201);",
                                    "// without it the answer names portaliq and nothing is written (409).",
                                    "pm.test('201 with the reader, or 409 naming portaliq', () => {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                                    "    if (pm.response.code === 201) {",
                                    "        pm.expect(pm.response.json().authorisedPersons).to.include(pm.collectionVariables.get('personId'));",
                                    "    } else {",
                                    "        pm.expect(pm.response.json().message.toLowerCase()).to.include('portaliq');",
                                    "    }",
                                    "});",
                                    "pm.test('the number is not in the answer', () => pm.expect(pm.response.text()).to.not.include('111222333'));",
                                    "pm.collectionVariables.set('readerAdded', pm.response.code === 201 ? 'yes' : 'no');"
                                ]
                            }
                        }
                    ]
                },
